font-size: 13px; margin-bottom: 16px; }&#10; .vk-opt { display: block; width: 100%; text-align: left; background: transparent;&#10; border: 1px solid var(--vk-border); border-radius: 12px; padding: 13px 15px;&#10; font-size: 15px; line-height: 1.5; color: var(--vk-text); cursor: pointer; margin-bottom: 10px; }&#10; .vk-opt:hover { border-color: var(--vk-accent); }&#10; .vk-opt.selected { border-color: var(--vk-accent); background: #fef3c7; }&#10; html[data-scheme="dark"] .vk-opt.selected { background: #451a03; }&#10; .vk-opt .vk-box { display: inline-block; width: 18px; height: 18px; border: 2px solid var(--vk-muted);&#10; border-radius: 5px; margin-right: 10px; vertical-align: -3px; text-align: center;&#10; line-height: 16px; font-size: 13px; color: #fff; }&#10; .vk-opt.selected .vk-box { background: var(--vk-accent); border-color: var(--vk-accent); }&#10; .vk-controls { display: flex; gap: 12px; justify-content: space-between; margin-top: 18px; }&#10; .vk-btn { border: none; border-radius: 12px; padding: 13px 28px; font-size: 16px; cursor: pointer; font-weight: 600; }&#10; .vk-btn-primary { background: var(--vk-focus); color: #fff; }&#10; .vk-btn-ghost { background: transparent; border: 1px solid var(--vk-border); color: var(--vk-text); }&#10; .vk-btn:disabled { opacity: .4; cursor: default; }&#10; #vk-warn { color: var(--vk-focus); font-size: 13px; margin-top: 12px; min-height: 18px; text-align: center; }&#10; .vk-result-emoji { font-size: 56px; text-align: center; }&#10; #vk-result-title { text-align: center; font-size: 22px; margin: 10px 0 8px; }&#10; #vk-result-desc { color: var(--vk-muted); font-size: 14px; line-height: 1.8; text-align: center; margin-bottom: 20px; }&#10; .vk-bar-row { margin-bottom: 12px; }&#10; .vk-bar-head { display: flex; justify-content: space-between; font-size: 14px; margin-bottom: 5px; }&#10; .vk-bar-head b { font-variant-numeric: tabular-nums; }&#10; .vk-bar-track { height: 10px; background: var(--vk-border); border-radius: 999px; overflow: hidden; }&#10; .vk-bar-fill { height: 100%; border-radius: 999px; }&#10; .vk-tips { margin-top: 20px; text-align: left; }&#10; .vk-tips h3 { font-size: 16px; margin-bottom: 8px; }&#10; .vk-tips ul { padding-left: 20px; }&#10; .vk-tips li { color: var(--vk-muted); font-size: 14px; line-height: 1.8; }&#10; .vk-share { text-align: center; margin-top: 20px; }&#10; .vk-share button { background: transparent; border: 1px dashed var(--vk-border); color: var(--vk-muted);&#10; border-radius: 999px; padding: 8px 18px; font-size: 13px; cursor: pointer; }&#10; #vk-share-msg { color: var(--vk-ok); font-size: 13px; margin-top: 8px; min-height: 18px; }&#10; .vk-restart { text-align: center; margin-top: 14px; }&#10; .vk-shared-note { background: #fef3c7; border: 1px solid var(--vk-accent); border-radius: 12px;&#10; padding: 10px 14px; font-size: 13px; color: var(--vk-muted); margin-bottom: 16px; text-align: center; }&#10; html[data-scheme="dark"] .vk-shared-note { background: #451a03; }&#10; .vk-info { text-align: left; margin-top: 8px; }&#10; .vk-info a { color: var(--vk-accent); }&#10;&lt;/style&gt;&#10;&lt;div class="vk-wrap"&gt;&#10;&lt;p class="vk-sub"&gt;16 道题 · 约 3 分钟 · 免费 · 无需注册&lt;/p&gt;&#10;&lt;div class="vk-card"&gt;&#10; &lt;div id="vk-start"&gt;&#10; &lt;div class="vk-start-emoji"&gt;🧠&lt;/div&gt;&#10; &lt;p class="vk-start-text"&gt;你学东西最快的方式是什么？看图、听讲、读写，还是动手？VARK 模型把学习偏好分成四种：&lt;b&gt;视觉、听觉、阅读 / 写作、动觉&lt;/b&gt;。回答 16 道情景题，找出最适合你的学习方式。&lt;/p&gt;&#10; &lt;div class="vk-center"&gt;&lt;button class="vk-btn vk-btn-primary" id="vk-start-btn"&gt;开始测评&lt;/button&gt;&lt;/div&gt;&#10; &lt;p class="vk-hint vk-center" style="margin-top:14px;"&gt;每题可以多选 · 没有对错 · 结果只保存在你的浏览器里&lt;/p&gt;&#10; &lt;/div&gt;&#10; &lt;div id="vk-question" style="display:none"&gt;&#10; &lt;div class="vk-progress"&gt;&lt;div class="vk-progress-fill" id="vk-progress-fill"&gt;&lt;/div&gt;&lt;/div&gt;&#10; &lt;div class="vk-progress-text" id="vk-progress-text"&gt;第 1 / 16 题&lt;/div&gt;&#10; &lt;h2 id="vk-q"&gt;&lt;/h2&gt;&#10; &lt;p class="vk-hint"&gt;可以多选：选所有符合你的选项&lt;/p&gt;&#10; &lt;div id="vk-options"&gt;&lt;/div&gt;&#10; &lt;div class="vk-controls"&gt;&#10; &lt;button class="vk-btn vk-btn-ghost" id="vk-prev"&gt;上一题&lt;/button&gt;&#10; &lt;button class="vk-btn vk-btn-primary" id="vk-next"&gt;下一题&lt;/button&gt;&#10; &lt;/div&gt;&#10; &lt;div id="vk-warn"&gt;&lt;/div&gt;&#10; &lt;/div&gt;&#10; &lt;div id="vk-result" style="display:none"&gt;&#10; &lt;div class="vk-shared-note" id="vk-shared-note" style="display:none"&gt;🔗 这是好友分享的测评结果&lt;/div&gt;&#10; &lt;div class="vk-result-emoji" id="vk-result-emoji"&gt;🎨&lt;/div&gt;&#10; &lt;h2 id="vk-result-title"&gt;&lt;/h2&gt;&#10; &lt;p id="vk-result-desc"&gt;&lt;/p&gt;&#10; &lt;div id="vk-bars"&gt;&lt;/div&gt;&#10; &lt;div class="vk-tips" id="vk-tips"&gt;&lt;/div&gt;&#10; &lt;div class="vk-share"&gt;&#10; &lt;button id="vk-share-btn"&gt;🔗 复制结果链接&lt;/button&gt;&#10; &lt;div id="vk-share-msg"&gt;&lt;/div&gt;&#10; &lt;/div&gt;&#10; &lt;div class="vk-restart"&gt;&lt;button class="vk-btn vk-btn-ghost" id="vk-restart"&gt;重新测评&lt;/button&gt;&lt;/div&gt;&#10; &lt;/div&gt;&#10;&lt;/div&gt;&#10;&lt;div class="vk-info"&gt;&#10;&lt;h2 id="什么是-vark"&gt;什么是 VARK？&#10;&lt;/h2&gt;&lt;p&gt;VARK 是新西兰学者 Neil Fleming 提出的学习风格模型，把人们偏好的信息接收方式分成四种：视觉（Visual，看图、图表）、听觉（Aural，听讲、讨论）、阅读 / 写作（Read / Write，读文字、写笔记）、动觉（Kinesthetic，动手、实践）。没有哪种更好——大多数人是多种方式的组合。&lt;/p&gt;&#10;&lt;h2 id="怎么用你的结果"&gt;怎么用你的结果？&#10;&lt;/h2&gt;&lt;ul&gt;&#10;&lt;li&gt;选最适合你的方式学新东西：视觉型多画图，听觉型多讲出来，阅读型多写笔记，动觉型马上动手练。&lt;/li&gt;&#10;&lt;li&gt;组合使用效果更好：比如先看图理解，再讲给别人听，最后动手做一遍。&lt;/li&gt;&#10;&lt;li&gt;想深入了解“讲出来才算学会”的方法，可以试试费曼学习法：把学到的讲给别人听，讲不出来就是没学会。&lt;/li&gt;&#10;&lt;/ul&gt;&#10;&lt;h2 id="说明"&gt;说明&#10;&lt;/h2&gt;&lt;p&gt;本测评为自测工具，题目为原创情景题，结果仅供参考，不能替代专业评估。&lt;/p&gt;&#10;&lt;h2 id="相关文章"&gt;相关文章&#10;&lt;/h2&gt;&lt;p&gt;&lt;a class="link" href="https://leekairos.com/p/episode-01-7902-articles/" target="_blank" rel="noopener"&#10; &gt;收藏了 7902 篇文章，为什么一篇都用不上？&lt;/a&gt; —— 学东西不是收藏，是用适合自己的方式处理。&lt;/p&gt;&#10;&lt;p&gt;&lt;a class="link" href="https://leekairos.com/tools/" &gt;更多免费工具 →&lt;/a&gt;&lt;/p&gt;&#10;&lt;/div&gt;&#10;&lt;/div&gt;&#10;&lt;script&gt;&#10;(function () {&#10; var MODES = ["V", "A", "R", "K"];&#10; var QUESTIONS = [&#10; { q: "你要学一个新软件（比如剪辑视频），你会怎么开始？", options: [&#10; { t: "先看官方的截图教程或视频演示", m: "V" },&#10; { t: "找人给我讲一遍，或者听音频讲解", m: "A" },&#10; { t: "先读文字版的使用手册或帮助文档", m: "R" },&#10; { t: "直接打开软件，边点边试，错了再改", m: "K" } ] },&#10; { q: "你要去一个没去过的地方，怎么记路线？", options: [&#10; { t: "让别人用说的告诉我怎么走", m: "A" },&#10; { t: "看地图，记住路口和地标的样子", m: "V" },&#10; { t: "跟着走一遍，身体记住转弯的感觉", m: "K" },&#10; { t: "把路线写下来，一步一步照着走", m: "R" } ] },&#10; { q: "背一串电话号码或密码，你会怎么做？", options: [&#10; { t: "把它写下来，多抄几遍", m: "R" },&#10; { t: "在键盘上多按几遍，靠手指记住位置", m: "K" },&#10; { t: "在脑子里想象这串数字的样子", m: "V" },&#10; { t: "反复念出来，靠声音记住", m: "A" } ] },&#10; { q: "学做一道新菜，你更喜欢哪种方式？", options: [&#10; { t: "直接上手做，尝着调整", m: "K" },&#10; { t: "看图片步骤或视频，照着样子做", m: "V" },&#10; { t: "听别人讲做法，或边听边做", m: "A" },&#10; { t: "照着文字菜谱一步一步做", m: "R" } ] },&#10; { q: "工作中要理解一个复杂的新概念（比如一个系统架构），你会怎么做？", options: [&#10; { t: "找同事聊一聊，讨论着理解", m: "A" },&#10; { t: "读文档、论文或书里的相关章节", m: "R" },&#10; { t: "搭一个小例子跑一跑，动手验证", m: "K" },&#10; { t: "画一张图，把各个部分的关系画出来", m: "V" } ] },&#10; { q: "准备一场考试，你最有效的复习方式是？", options: [&#10; { t: "用不同颜色的笔做思维导图、画重点", m: "V" },&#10; { t: "反复读笔记、重写重点、做文字总结", m: "R" },&#10; { t: "做题、模拟考试，在练习中巩固", m: "K" },&#10; { t: "把知识点讲给别人听，或自己录音回听", m: "A" } ] },&#10; { q: "开会时别人讲一个新方案，你怎么跟上？", options: [&#10; { t: "记笔记，把要点写下来", m: "R" },&#10; { t: "认真听讲解，边听边在心里复述", m: "A" },&#10; { t: "看着白板 / PPT 上的图和关键词", m: "V" },&#10; { t: "边听边画草图、摆弄手边的东西来思考", m: "K" } ] },&#10; { q: "你想记住一个人的名字和长相，你会怎么做？", options: [&#10; { t: "和他握手、一起做点事，在互动中记住", m: "K" },&#10; { t: "多叫几遍他的名字，记住发音", m: "A" },&#10; { t: "把名字写下来，或者存到通讯录里备注", m: "R" },&#10; { t: "记住他的脸、穿着和样子", m: "V" } ] },&#10; { q: "学一门新语言，你最喜欢哪种方式？", options: [&#10; { t: "看带图片的单词卡、图表和视频", m: "V" },&#10; { t: "在真实场景里说、用，边用边学", m: "K" },&#10; { t: "多听、多跟读，靠耳朵和嘴巴学", m: "A" },&#10; { t: "读课文、写单词、记语法笔记", m: "R" } ] },&#10; { q: "买一件不熟悉的家电（比如咖啡机），你怎么学会用？", options: [&#10; { t: "问店员或朋友，让他们口头教我", m: "A" },&#10; { t: "直接开机试，按钮一个一个按过去", m: "K" },&#10; { t: "仔细读说明书的文字步骤", m: "R" },&#10; { t: "看说明书里的图示或网上的演示视频", m: "V" } ] },&#10; { q: "你要给别人解释一个想法，你会怎么做？", options: [&#10; { t: "写一段文字或发个文档给他", m: "R" },&#10; { t: "画图或找一张图来说明", m: "V" },&#10; { t: "拿实物演示，或者带他实际操作一遍", m: "K" },&#10; { t: "直接讲出来，边讲边调整", m: "A" } ] },&#10; { q: "读一本非虚构的书，你怎么读效果最好？", options: [&#10; { t: "读完马上找个地方实践书里的内容", m: "K" },&#10; { t: "做文字笔记、划线、写读后感", m: "R" },&#10; { t: "边读边画图、做图表笔记", m: "V" },&#10; { t: "听有声书，或者读出声来", m: "A" } ] },&#10; { q: "学跳舞或一项运动动作，你会怎么做？", options: [&#10; { t: "听教练口头讲解动作要领", m: "A" },&#10; { t: "看教练示范或视频，模仿动作的样子", m: "V" },&#10; { t: "先看文字分解步骤，再照着做", m: "R" },&#10; { t: "直接跟着做，靠身体感觉调整", m: "K" } ] },&#10; { q: "你要记住一周的日程安排，你会怎么做？", options: [&#10; { t: "在日历上用颜色块标出来，一眼看到", m: "V" },&#10; { t: "每天早上自己念一遍今天的安排", m: "A" },&#10; { t: "把安排和具体的行动绑定（比如“开完会就去跑步”）", m: "K" },&#10; { t: "写一张待办清单，逐项打勾", m: "R" } ] },&#10; { q: "遇到一个修东西的问题（比如换水龙头），你会怎么做？", options: [&#10; { t: "找文字版的维修指南照着步骤做", m: "R" },&#10; { t: "直接拆开看，边拆边琢磨", m: "K" },&#10; { t: "打电话问懂行的朋友，边听边做", m: "A" },&#10; { t: "搜一张拆解图或视频，照着图做", m: "V" } ] },&#10; { q: "回顾你最近学到的东西，哪种方式让你记得最牢？", options: [&#10; { t: "记得自己动手做过的那件事", m: "K" },&#10; { t: "脑子里浮现出当时的画面、图表", m: "V" },&#10; { t: "记得自己写下的笔记和文字", m: "R" },&#10; { t: "记得当时听到的讲解和讨论", m: "A" } ] }&#10; ];&#10; var STYLES = {&#10; V: { name: "视觉型", en: "Visual", emoji: "🎨", color: "#3b82f6",&#10; desc: "你靠眼睛学习：图表、颜色、画面最能帮你记住东西。看到的东西，比听到的更容易进脑子。",&#10; tips: ["用思维导图和流程图整理知识", "用不同颜色的笔标记重点", "多看视频和图示教程", "把抽象概念画出来再理解"] },&#10; A: { name: "听觉型", en: "Aural", emoji: "👂", color: "#22c55e",&#10; desc: "你靠耳朵学习：听讲、讨论、复述最能帮你记住东西。说出来、听进去，是你的学习方式。",&#10; tips: ["把内容讲给别人听（费曼技巧）", "听播客和有声书", "录音回听自己的讲解", "参加讨论，而不是只看书"] },&#10; R: { name: "阅读 / 写作型", en: "Read/Write", emoji: "✍️", color: "#f59e0b",&#10; desc: "你靠文字学习：读、写、整理笔记最能帮你记住东西。写下来的东西，才真正属于你。",&#10; tips: ["做文字笔记和总结", "用清单和提纲梳理知识", "多写：写博客、写复盘", "读原版书和官方文档"] },&#10; K: { name: "动觉型", en: "Kinesthetic", emoji: "🙌", color: "#ef4444",&#10; desc: "你靠动手学习：实践、体验、试错最能帮你记住东西。做过一遍，比看十遍都管用。",&#10; tips: ["边学边做，马上找个项目练手", "做题、模拟、实操", "学东西时走动、比划", "把知识用到真实场景里"] }&#10; };&#10;&#10; var startScreen = document.getElementById("vk-start");&#10; var questionScreen = document.getElementById("vk-question");&#10; var resultScreen = document.getElementById("vk-result");&#10; var qText = document.getElementById("vk-q");&#10; var optionsEl = document.getElementById("vk-options");&#10; var progressFill = document.getElementById("vk-progress-fill");&#10; var progressText = document.getElementById("vk-progress-text");&#10; var prevBtn = document.getElementById("vk-prev");&#10; var nextBtn = document.getElementById("vk-next");&#10; var warnMsg = document.getElementById("vk-warn");&#10; var shareBtn = document.getElementById("vk-share-btn");&#10; var shareMsg = document.getElementById("vk-share-msg");&#10; var restartBtn = document.getElementById("vk-restart");&#10;&#10; var idx = 0;&#10; var answers = QUESTIONS.map(function () { return []; });&#10; var resultLabel = "";&#10; var shownCounts = null;&#10;&#10; function show(screen) {&#10; startScreen.style.display = "none";&#10; questionScreen.style.display = "none";&#10; resultScreen.style.display = "none";&#10; screen.style.display = "block";&#10; }&#10; function renderQuestion() {&#10; var q = QUESTIONS[idx];&#10; qText.textContent = q.q;&#10; progressFill.style.width = ((idx + 1) / QUESTIONS.length * 100) + "%";&#10; progressText.textContent = "第 " + (idx + 1) + " / " + QUESTIONS.length + " 题";&#10; prevBtn.disabled = idx === 0;&#10; nextBtn.textContent = idx === QUESTIONS.length - 1 ? "查看结果" : "下一题";&#10; warnMsg.textContent = "";&#10; optionsEl.innerHTML = "";&#10; q.options.forEach(function (opt, i) {&#10; var b = document.createElement("button");&#10; b.className = "vk-opt" + (answers[idx].indexOf(i) !== -1 ? " selected" : "");&#10; b.innerHTML = '&lt;span class="vk-box"&gt;' + (answers[idx].indexOf(i) !== -1 ? "✓" : "") + "&lt;/span&gt;" + opt.t;&#10; b.addEventListener("click", function () {&#10; var pos = answers[idx].indexOf(i);&#10; if (pos === -1) answers[idx].push(i); else answers[idx].splice(pos, 1);&#10; renderQuestion();&#10; });&#10; optionsEl.appendChild(b);&#10; });&#10; }&#10; function score() {&#10; var counts = { V: 0, A: 0, R: 0, K: 0 };&#10; QUESTIONS.forEach(function (q, qi) {&#10; answers[qi].forEach(function (oi) { counts[q.options[oi].m] += 1; });&#10; });&#10; return counts;&#10; }&#10; function showResult(counts, shared) {&#10; if (!counts) counts = score();&#10; var max = Math.max(counts.V, counts.A, counts.R, counts.K);&#10; var preferred = MODES.filter(function (m) { return counts[m] &gt;= max - 2 &amp;&amp; counts[m] &gt; 0; });&#10; var title, desc, emoji;&#10; if (preferred.length === 1) {&#10; var s = STYLES[preferred[0]];&#10; emoji = s.emoji;&#10; title = "你是" + s.name + "学习者";&#10; desc = s.desc;&#10; } else {&#10; emoji = "🌈";&#10; title = "你是多模式学习者";&#10; desc = "你的得分比较接近（" + preferred.map(function (m) { return STYLES[m].name; }).join(" + ") + "），说明你不依赖单一方式——组合使用几种方式，效果最好。";&#10; }&#10; document.getElementById("vk-result-emoji").textContent = emoji;&#10; document.getElementById("vk-result-title").textContent = title;&#10; document.getElementById("vk-result-desc").textContent = desc;&#10; resultLabel = preferred.map(function (m) { return STYLES[m].name; }).join(" + ") + (preferred.length &gt; 1 ? "（多模式）" : "");&#10; shownCounts = counts;&#10; if (shared) {&#10; document.getElementById("vk-shared-note").style.display = "block";&#10; restartBtn.textContent = "我也测一测";&#10; } else {&#10; document.getElementById("vk-shared-note").style.display = "none";&#10; restartBtn.textContent = "重新测评";&#10; }&#10; var bars = document.getElementById("vk-bars");&#10; bars.innerHTML = "";&#10; MODES.forEach(function (m) {&#10; var s = STYLES[m];&#10; var row = document.createElement("div");&#10; row.className = "vk-bar-row";&#10; row.innerHTML = '&lt;div class="vk-bar-head"&gt;&lt;span&gt;' + s.emoji + " " + s.name + " · " + s.en + '&lt;/span&gt;&lt;b&gt;' + counts[m] + " / 16&lt;/b&gt;&lt;/div&gt;"&#10; + '&lt;div class="vk-bar-track"&gt;&lt;div class="vk-bar-fill" style="width:' + (counts[m] / 16 * 100) + "%;background:" + s.color + '"&gt;&lt;/div&gt;&lt;/div&gt;';&#10; bars.appendChild(row);&#10; });&#10; var tipsBox = document.getElementById("vk-tips");&#10; tipsBox.innerHTML = "&lt;h3&gt;适合你的学习方法&lt;/h3&gt;";&#10; preferred.forEach(function (m) {&#10; var s = STYLES[m];&#10; var h = document.createElement("p");&#10; h.style.cssText = "font-weight:600;margin:10px 0 4px;";&#10; h.textContent = s.emoji + " " + s.name;&#10; tipsBox.appendChild(h);&#10; var ul = document.createElement("ul");&#10; s.tips.forEach(function (t) {&#10; var li = document.createElement("li");&#10; li.textContent = t;&#10; ul.appendChild(li);&#10; });&#10; tipsBox.appendChild(ul);&#10; });&#10; show(resultScreen);&#10; }&#10;&#10; document.getElementById("vk-start-btn").addEventListener("click", function () {&#10; idx = 0;&#10; answers = QUESTIONS.map(function () { return []; });&#10; show(questionScreen);&#10; renderQuestion();&#10; });&#10; prevBtn.addEventListener("click", function () {&#10; if (idx &gt; 0) { idx -= 1; renderQuestion(); }&#10; });&#10; nextBtn.addEventListener("click", function () {&#10; if (answers[idx].length === 0) { warnMsg.textContent = "请至少选一个选项，再继续。"; return; }&#10; if (idx === QUESTIONS.length - 1) showResult();&#10; else { idx += 1; renderQuestion(); }&#10; });&#10; document.getElementById("vk-restart").addEventListener("click", function () {&#10; idx = 0;&#10; answers = QUESTIONS.map(function () { return []; });&#10; shareMsg.textContent = "";&#10; show(startScreen);&#10; });&#10; shareBtn.addEventListener("click", function () {&#10; var c = shownCounts || score();&#10; var url = "https://leekairos.com/tools/vark/?v=" + c.V + "&amp;a=" + c.A + "&amp;r=" + c.R + "&amp;k=" + c.K;&#10; function done() { shareMsg.textContent = "链接已复制，去分享你的测评结果吧！"; }&#10; if (navigator.clipboard &amp;&amp; navigator.clipboard.writeText) {&#10; navigator.clipboard.writeText(url).then(done, function () { shareMsg.textContent = url; });&#10; } else { shareMsg.textContent = url; }&#10; });&#10;&#10; // shared result link: ?v=..&amp;a=..&amp;r=..&amp;k=..&#10; (function () {&#10; try {&#10; var p = new URLSearchParams(location.search);&#10; var c = { V: +p.get("v"), A: +p.get("a"), R: +p.get("r"), K: +p.get("k") };&#10; var ok = MODES.every(function (m) {&#10; return p.get(m.toLowerCase()) !== null &amp;&amp; Number.isInteger(c[m]) &amp;&amp; c[m] &gt;= 0 &amp;&amp; c[m] &lt;= 16;&#10; });&#10; if (ok &amp;&amp; (c.V + c.A + c.R + c.K) &gt; 0) { showResult(c, true); }&#10; } catch (e) {}&#10; })();&#10;})();&#10;&lt;/script&gt;&#10;</description></item><item><title>在线番茄钟</title><link>https://leekairos.com/tools/pomodoro/</link><pubDate>Fri, 20 Nov 2026 11:00:00 +0800</pubDate><guid>https://leekairos.com/tools/pomodoro/</guid><description>&lt;style&gt;&#10; .pm-wrap { max-width: 560px; margin: 0 auto; text-align: center;&#10; --pm-card: #ffffff; --pm-text: #1c1c1e; --pm-muted: #6b7280; --pm-border: #e4e4e7;&#10; --pm-accent: #f59e0b; --pm-focus: #ef4444; --pm-short: #22c55e; --pm-long: #3b82f6;&#10; --pm-ring: #e5e7eb; --pm-input-bg: #f4f4f5; color: var(--pm-text); }&#10; html[data-scheme="dark"] .pm-wrap {&#10; --pm-card: #1e293b; --pm-text: #f1f5f9; --pm-muted: #94a3b8; --pm-border: #334155;&#10; --pm-accent: #f59e0b; --pm-ring: #334155; --pm-input-bg: #0f172a; }&#10; .pm-sub { color: var(--pm-muted); font-size: 14px; margin-bottom: 20px; }&#10; .pm-card { background: var(--pm-card); border: 1px solid var(--pm-border);&#10; border-radius: 20px; padding: 28px 24px 24px; box-shadow: 0 4px 24px rgba(0,0,0,.06); }&#10; .pm-modes { display: flex; gap: 8px; justify-content: center; margin-bottom: 20px; flex-wrap: wrap; }&#10; .pm-mode-btn { border: 1px solid var(--pm-border); background: transparent; color: var(--pm-muted);&#10; padding: 8px 16px; border-radius: 999px; font-size: 14px; cursor: pointer; }&#10; .pm-mode-btn.active[data-mode="focus"] { background: var(--pm-focus); border-color: var(--pm-focus); color: #fff; }&#10; .pm-mode-btn.active[data-mode="short"] { background: var(--pm-short); border-color: var(--pm-short); color: #fff; }&#10; .pm-mode-btn.active[data-mode="long"] { background: var(--pm-long); border-color: var(--pm-long); color: #fff; }&#10; .pm-ring-wrap { position: relative; width: 260px; height: 260px; margin: 0 auto 8px; }&#10; .pm-ring-wrap svg { transform: rotate(-90deg); }&#10; .pm-ring-bg { fill: none; stroke: var(--pm-ring); stroke-width: 10; }&#10; .pm-ring-fg { fill: none; stroke: var(--pm-focus); stroke-width: 10; stroke-linecap: round;&#10; transition: stroke-dashoffset .3s linear, stroke .3s; }&#10; .pm-time-box { position: absolute; inset: 0; display: flex; flex-direction: column;&#10; align-items: center; justify-content: center; }&#10; #pm-time { font-size: 56px; font-weight: 700; font-variant-numeric: tabular-nums; letter-spacing: 2px; }&#10; #pm-mode-label { color: var(--pm-muted); font-size: 15px; margin-top: 4px; }&#10; .pm-dots { display: flex; gap: 8px; justify-content: center; margin: 10px 0 18px; }&#10; .pm-dot { width: 12px; height: 12px; border-radius: 50%; border: 2px solid var(--pm-muted); }&#10; .pm-dot.done { background: var(--pm-focus); border-color: var(--pm-focus); }&#10; .pm-controls { display: flex; gap: 12px; justify-content: center; }&#10; .pm-btn { border: none; border-radius: 12px; padding: 13px 34px; font-size: 17px;&#10; cursor: pointer; font-weight: 600; }&#10; .pm-btn-primary { background: var(--pm-focus); color: #fff; }&#10; .pm-btn-primary.break-short { background: var(--pm-short); }&#10; .pm-btn-primary.break-long { background: var(--pm-long); }&#10; .pm-btn-ghost { background: transparent; border: 1px solid var(--pm-border); color: var(--pm-text); }&#10; .pm-stats { display: flex; justify-content: center; gap: 28px; margin-top: 22px;&#10; padding-top: 18px; border-top: 1px solid var(--pm-border); text-align: center; }&#10; .pm-stats b { font-size: 22px; display: block; }&#10; .pm-stats span { color: var(--pm-muted); font-size: 13px; }&#10; .pm-share { text-align: center; margin-top: 16px; }&#10; .pm-share button { background: transparent; border: 1px dashed var(--pm-border); color: var(--pm-muted);&#10; border-radius: 999px; padding: 8px 18px; font-size: 13px; cursor: pointer; }&#10; #pm-share-msg { color: var(--pm-short); font-size: 13px; margin-top: 8px; min-height: 18px; }&#10; .pm-details { margin-top: 22px; border-top: 1px solid var(--pm-border); padding-top: 16px; text-align: left; }&#10; .pm-summary { cursor: pointer; font-weight: 600; font-size: 15px; }&#10; .pm-settings { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 14px; }&#10; .pm-settings label { font-size: 13px; color: var(--pm-muted); display: block; margin-bottom: 4px; }&#10; .pm-settings input[type="number"] { width: 100%; padding: 9px 10px; border: 1px solid var(--pm-border);&#10; border-radius: 9px; font-size: 15px; background: var(--pm-input-bg); color: var(--pm-text); }&#10; .pm-check { display: flex; align-items: center; gap: 8px; font-size: 14px; margin-top: 14px; }&#10; .pm-info { text-align: left; margin-top: 8px; }&#10; .pm-info a { color: var(--pm-accent); }&#10; .pm-more-tools { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }&#10; .pm-tool-chip { border: 1px solid var(--pm-border); border-radius: 999px; padding: 7px 14px;&#10; font-size: 13px; color: var(--pm-muted); }&#10; .pm-modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,.5); display: none;&#10; align-items: center; justify-content: center; z-index: 50; padding: 20px; }&#10; .pm-modal-overlay.show { display: flex; }&#10; .pm-modal { background: var(--pm-card); border: 1px solid var(--pm-border); border-radius: 20px;&#10; padding: 28px 24px; text-align: center; max-width: 340px; width: 100%;&#10; box-shadow: 0 12px 40px rgba(0,0,0,.25); }&#10; .pm-modal .pm-big { font-size: 44px; }&#10; .pm-modal h3 { font-size: 22px; margin: 10px 0 6px; }&#10; .pm-modal p { color: var(--pm-muted); font-size: 14px; line-height: 1.7; }&#10; .pm-modal .pm-btn { margin-top: 18px; }&#10; .pm-shared-banner { background: #fef3c7; border: 1px solid var(--pm-accent); border-radius: 12px;&#10; padding: 12px 16px; font-size: 14px; color: var(--pm-muted); margin-bottom: 16px; text-align: center; line-height: 1.6; }&#10; .pm-shared-banner b { color: var(--pm-text); font-size: 16px; }&#10; html[data-scheme="dark"] .pm-shared-banner { background: #451a03; }&#10;&lt;/style&gt;&#10;&lt;div class="pm-wrap"&gt;&#10;&lt;p class="pm-sub"&gt;免费 · 打开即用 · 无需注册&lt;/p&gt;&#10;&lt;div class="pm-shared-banner" id="pm-shared-banner" style="display:none"&gt;🍅 好友分享：今天已专注 &lt;b id="pm-shared-minutes"&gt;0&lt;/b&gt; 分钟，完成 &lt;b id="pm-shared-count"&gt;0&lt;/b&gt; 个番茄钟&lt;/div&gt;&#10;&lt;div class="pm-card"&gt;&#10; &lt;div class="pm-modes"&gt;&#10; &lt;button class="pm-mode-btn active" data-mode="focus"&gt;专注 Focus&lt;/button&gt;&#10; &lt;button class="pm-mode-btn" data-mode="short"&gt;短休息 Short Break&lt;/button&gt;&#10; &lt;button class="pm-mode-btn" data-mode="long"&gt;长休息 Long Break&lt;/button&gt;&#10; &lt;/div&gt;&#10; &lt;div class="pm-ring-wrap"&gt;&#10; &lt;svg width="260" height="260" viewBox="0 0 260 260"&gt;&#10; &lt;circle class="pm-ring-bg" cx="130" cy="130" r="118"&gt;&lt;/circle&gt;&#10; &lt;circle class="pm-ring-fg" id="pm-ring" cx="130" cy="130" r="118"&gt;&lt;/circle&gt;&#10; &lt;/svg&gt;&#10; &lt;div class="pm-time-box"&gt;&#10; &lt;div id="pm-time"&gt;25:00&lt;/div&gt;&#10; &lt;div id="pm-mode-label"&gt;专注中 · 第 1 个番茄&lt;/div&gt;&#10; &lt;/div&gt;&#10; &lt;/div&gt;&#10; &lt;div class="pm-dots" id="pm-dots"&gt;&#10; &lt;span class="pm-dot"&gt;&lt;/span&gt;&lt;span class="pm-dot"&gt;&lt;/span&gt;&lt;span class="pm-dot"&gt;&lt;/span&gt;&lt;span class="pm-dot"&gt;&lt;/span&gt;&#10; &lt;/div&gt;&#10; &lt;div class="pm-controls"&gt;&#10; &lt;button class="pm-btn pm-btn-primary" id="pm-start"&gt;开始&lt;/button&gt;&#10; &lt;button class="pm-btn pm-btn-ghost" id="pm-reset"&gt;重置&lt;/button&gt;&#10; &lt;/div&gt;&#10; &lt;div class="pm-stats"&gt;&#10; &lt;div&gt;&lt;b id="pm-today-count"&gt;0&lt;/b&gt;&lt;span&gt;今日番茄&lt;/span&gt;&lt;/div&gt;&#10; &lt;div&gt;&lt;b id="pm-today-minutes"&gt;0 分钟&lt;/b&gt;&lt;span&gt;今日专注&lt;/span&gt;&lt;/div&gt;&#10; &lt;div&gt;&lt;b id="pm-cycle-count"&gt;0 / 4&lt;/b&gt;&lt;span&gt;本轮进度&lt;/span&gt;&lt;/div&gt;&#10; &lt;/div&gt;&#10; &lt;div class="pm-share"&gt;&#10; &lt;button id="pm-share-btn"&gt;🔗 复制专注成绩链接&lt;/button&gt;&#10; &lt;div id="pm-share-msg"&gt;&lt;/div&gt;&#10; &lt;/div&gt;&#10; &lt;details class="pm-details"&gt;&#10; &lt;summary class="pm-summary"&gt;⚙️ 设置&lt;/summary&gt;&#10; &lt;div class="pm-settings"&gt;&#10; &lt;div&gt;&lt;label&gt;专注时长（分钟）&lt;/label&gt;&lt;input type="number" id="pm-set-focus" value="25" min="1" max="120"&gt;&lt;/div&gt;&#10; &lt;div&gt;&lt;label&gt;短休息（分钟）&lt;/label&gt;&lt;input type="number" id="pm-set-short" value="5" min="1" max="30"&gt;&lt;/div&gt;&#10; &lt;div&gt;&lt;label&gt;长休息（分钟）&lt;/label&gt;&lt;input type="number" id="pm-set-long" value="15" min="1" max="60"&gt;&lt;/div&gt;&#10; &lt;div&gt;&lt;label&gt;几个番茄后长休息&lt;/label&gt;&lt;input type="number" id="pm-set-cycle" value="4" min="2" max="8"&gt;&lt;/div&gt;&#10; &lt;/div&gt;&#10; &lt;label class="pm-check"&gt;&lt;input type="checkbox" id="pm-set-auto" checked&gt; 结束后自动切换到下一阶段&lt;/label&gt;&#10; &lt;label class="pm-check"&gt;&lt;input type="checkbox" id="pm-set-sound" checked&gt; 结束时播放提示音&lt;/label&gt;&#10; &lt;label class="pm-check"&gt;&lt;input type="checkbox" id="pm-set-notif" checked&gt; 结束时弹出浏览器通知（切到别的页面也能看到）&lt;/label&gt;&#10; &lt;/details&gt;&#10;&lt;/div&gt;&#10;&lt;div class="pm-info"&gt;&#10;&lt;h2 id="什么是番茄工作法"&gt;什么是番茄工作法？&#10;&lt;/h2&gt;&lt;p&gt;番茄工作法很简单：专注 25 分钟，然后休息 5 分钟，这就是一个“番茄”。每完成 4 个番茄，休息一个长的 15 分钟。短而固定的节奏，让注意力更容易集中，也更不容易累。&lt;/p&gt;&#10;&lt;h2 id="怎么用"&gt;怎么用？&#10;&lt;/h2&gt;&lt;ol&gt;&#10;&lt;li&gt;点“开始”，25 分钟里只做一件事，手机放一边。&lt;/li&gt;&#10;&lt;li&gt;时间到会弹窗提醒 + 响铃，即使切到别的页面，浏览器通知也会弹出来。起来走走、喝口水，休息 5 分钟。&lt;/li&gt;&#10;&lt;li&gt;4 个番茄后，给自己一个 15 分钟的长休息。&lt;/li&gt;&#10;&lt;li&gt;每天的番茄数和专注分钟数会自动记下来，关掉页面也不丢。&lt;/li&gt;&#10;&lt;/ol&gt;&#10;&lt;h2 id="更多工具即将上线"&gt;更多工具（即将上线）&#10;&lt;/h2&gt;&lt;div class="pm-more-tools"&gt;&#10; &lt;span class="pm-tool-chip"&gt;📇 英语单词闪卡&lt;/span&gt;&#10; &lt;span class="pm-tool-chip"&gt;⌨️ 打字速度测试&lt;/span&gt;&#10; &lt;span class="pm-tool-chip"&gt;📖 阅读速度测试&lt;/span&gt;&#10; &lt;span class="pm-tool-chip"&gt;🎲 随机口语话题&lt;/span&gt;&#10;&lt;/div&gt;&#10;&lt;h2 id="相关文章"&gt;相关文章&#10;&lt;/h2&gt;&lt;p&gt;&lt;a class="link" href="https://leekairos.com/p/episode-01-7902-articles/" target="_blank" rel="noopener"&#10; &gt;收藏了 7902 篇文章，为什么一篇都用不上？&lt;/a&gt; —— 收藏再多也不如每天 25 分钟的专注处理。&lt;/p&gt;&#10;&lt;p&gt;&lt;a class="link" href="https://leekairos.com/tools/" &gt;更多免费工具 →&lt;/a&gt;&lt;/p&gt;&#10;&lt;/div&gt;&#10;&lt;div class="pm-modal-overlay" id="pm-modal"&gt;&#10; &lt;div class="pm-modal"&gt;&#10; &lt;div class="pm-big" id="pm-modal-emoji"&gt;⏰&lt;/div&gt;&#10; &lt;h3 id="pm-modal-title"&gt;时间到！&lt;/h3&gt;&#10; &lt;p id="pm-modal-text"&gt;&lt;/p&gt;&#10; &lt;button class="pm-btn pm-btn-primary" id="pm-modal-ok"&gt;知道了&lt;/button&gt;&#10; &lt;/div&gt;&#10;&lt;/div&gt;&#10;&lt;/div&gt;&#10;&lt;script&gt;&#10;(function () {&#10; var CIRC = 2 * Math.PI * 118;&#10; var ring = document.getElementById('pm-ring');&#10; var timeEl = document.getElementById('pm-time');&#10; var modeLabel = document.getElementById('pm-mode-label');&#10; var startBtn = document.getElementById('pm-start');&#10; var resetBtn = document.getElementById('pm-reset');&#10; var dotsEl = document.getElementById('pm-dots');&#10; var todayCountEl = document.getElementById('pm-today-count');&#10; var todayMinutesEl = document.getElementById('pm-today-minutes');&#10; var cycleCountEl = document.getElementById('pm-cycle-count');&#10; var shareBtn = document.getElementById('pm-share-btn');&#10; var shareMsg = document.getElementById('pm-share-msg');&#10;&#10; var COLORS = { focus: '#ef4444', short: '#22c55e', long: '#3b82f6' };&#10; var LABELS = { focus: '专注', short: '短休息', long: '长休息' };&#10; var MODE_NAMES = { focus: 'Focus', short: 'Short Break', long: 'Long Break' };&#10;&#10; var settings = loadSettings();&#10; var state = { mode: 'focus', running: false, remaining: settings.focus * 60, endAt: 0, timer: null, completedInCycle: 0 };&#10; var stats = loadStats();&#10;&#10; ring.style.strokeDasharray = CIRC;&#10; ring.style.strokeDashoffset = 0;&#10;&#10; function loadSettings() {&#10; try {&#10; var s = JSON.parse(localStorage.getItem('pomodoro-settings') || '{}');&#10; return {&#10; focus: s.focus || 25, short: s.short || 5, long: s.long || 15,&#10; cycle: s.cycle || 4, auto: s.auto !== false, sound: s.sound !== false,&#10; notif: s.notif !== false&#10; };&#10; } catch (e) {&#10; return { focus: 25, short: 5, long: 15, cycle: 4, auto: true, sound: true, notif: true };&#10; }&#10; }&#10; function saveSettings() {&#10; try { localStorage.setItem('pomodoro-settings', JSON.stringify(settings)); } catch (e) {}&#10; }&#10; function todayKey() { return new Date().toISOString().slice(0, 10); }&#10; function loadStats() {&#10; try {&#10; var s = JSON.parse(localStorage.getItem('pomodoro-stats') || '{}');&#10; if (s.date !== todayKey()) return { date: todayKey(), count: 0, minutes: 0 };&#10; return s;&#10; } catch (e) { return { date: todayKey(), count: 0, minutes: 0 }; }&#10; }&#10; function saveStats() {&#10; try { localStorage.setItem('pomodoro-stats', JSON.stringify(stats)); } catch (e) {}&#10; }&#10;&#10; function fmt(sec) {&#10; sec = Math.max(0, Math.ceil(sec));&#10; var m = Math.floor(sec / 60), s = sec % 60;&#10; return (m &lt; 10 ? '0' : '') + m + ':' + (s &lt; 10 ? '0' : '') + s;&#10; }&#10; function totalFor(mode) {&#10; return (mode === 'focus' ? settings.focus : mode === 'short' ? settings.short : settings.long) * 60;&#10; }&#10; function render() {&#10; timeEl.textContent = fmt(state.remaining);&#10; ring.style.stroke = COLORS[state.mode];&#10; ring.style.strokeDashoffset = CIRC * (1 - state.remaining / totalFor(state.mode));&#10; startBtn.textContent = state.running ? '暂停' : (state.remaining &lt; totalFor(state.mode) ? '继续' : '开始');&#10; startBtn.classList.toggle('break-short', state.mode === 'short');&#10; startBtn.classList.toggle('break-long', state.mode === 'long');&#10; var label = LABELS[state.mode] + (state.mode === 'focus' ? '中 · 第 ' + (state.completedInCycle + 1) + ' 个番茄' : '中');&#10; modeLabel.textContent = state.running ? label : LABELS[state.mode] + ' · ' + MODE_NAMES[state.mode];&#10; document.title = fmt(state.remaining) + ' · ' + LABELS[state.mode] + ' | 在线番茄钟';&#10; var dots = dotsEl.children;&#10; for (var i = 0; i &lt; dots.length; i++) {&#10; dots[i].classList.toggle('done', i &lt; state.completedInCycle);&#10; }&#10; todayCountEl.textContent = stats.count;&#10; todayMinutesEl.textContent = stats.minutes + ' 分钟';&#10; cycleCountEl.textContent = state.completedInCycle + ' / ' + settings.cycle;&#10; }&#10; function setMode(mode, resetRemaining) {&#10; state.mode = mode;&#10; state.running = false;&#10; clearInterval(state.timer);&#10; if (resetRemaining !== false) state.remaining = totalFor(mode);&#10; document.querySelectorAll('.pm-mode-btn').forEach(function (b) {&#10; b.classList.toggle('active', b.dataset.mode === mode);&#10; });&#10; render();&#10; }&#10; function beep() {&#10; if (!settings.sound) return;&#10; try {&#10; var ctx = new (window.AudioContext || window.webkitAudioContext)();&#10; [0, 1, 2, 3, 4, 5].forEach(function (i) {&#10; var o = ctx.createOscillator(), g = ctx.createGain();&#10; o.connect(g); g.connect(ctx.destination);&#10; o.frequency.value = 880;&#10; g.gain.setValueAtTime(0.0001, ctx.currentTime + i * 0.35);&#10; g.gain.exponentialRampToValueAtTime(0.25, ctx.currentTime + i * 0.35 + 0.02);&#10; g.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + i * 0.35 + 0.3);&#10; o.start(ctx.currentTime + i * 0.35);&#10; o.stop(ctx.currentTime + i * 0.35 + 0.32);&#10; });&#10; } catch (e) {}&#10; }&#10; function notify(title, body) {&#10; if (!settings.notif) return;&#10; try {&#10; if ('Notification' in window &amp;&amp; Notification.permission === 'granted') {&#10; new Notification(title, { body: body });&#10; }&#10; } catch (e) {}&#10; }&#10; function showModal(emoji, title, text) {&#10; document.getElementById('pm-modal-emoji').textContent = emoji;&#10; document.getElementById('pm-modal-title').textContent = title;&#10; document.getElementById('pm-modal-text').textContent = text;&#10; document.getElementById('pm-modal').classList.add('show');&#10; }&#10; function onFinish() {&#10; state.running = false;&#10; clearInterval(state.timer);&#10; beep();&#10; var nextMode, emoji, title, text;&#10; if (state.mode === 'focus') {&#10; stats.count += 1;&#10; stats.minutes += settings.focus;&#10; saveStats();&#10; state.completedInCycle += 1;&#10; nextMode = state.completedInCycle &gt;= settings.cycle ? 'long' : 'short';&#10; if (nextMode === 'long') state.completedInCycle = 0;&#10; emoji = '🍅';&#10; title = '专注结束！';&#10; text = '你完成了 ' + settings.focus + ' 分钟专注，' + (settings.auto ? '已自动开始' : '接下来') + (nextMode === 'long' ? '长休息 ' + settings.long + ' 分钟。' : '短休息 ' + settings.short + ' 分钟。');&#10; notify('🍅 专注结束！', '完成了 ' + settings.focus + ' 分钟专注，休息一下吧。');&#10; } else {&#10; nextMode = 'focus';&#10; emoji = '⏰';&#10; title = '休息结束！';&#10; text = '休息好了，' + (settings.auto ? '已自动开始' : '准备好就点开始') + '下一个番茄吧。';&#10; notify('⏰ 休息结束！', '开始下一个番茄，继续专注。');&#10; }&#10; showModal(emoji, title, text);&#10; setMode(nextMode);&#10; if (settings.auto) start();&#10; render();&#10; }&#10; function tick() {&#10; state.remaining = Math.max(0, (state.endAt - Date.now()) / 1000);&#10; if (state.remaining &lt;= 0) { onFinish(); return; }&#10; render();&#10; }&#10; function start() {&#10; state.running = true;&#10; state.endAt = Date.now() + state.remaining * 1000;&#10; clearInterval(state.timer);&#10; state.timer = setInterval(tick, 250);&#10; render();&#10; }&#10; function pause() {&#10; state.running = false;&#10; clearInterval(state.timer);&#10; render();&#10; }&#10; startBtn.addEventListener('click', function () {&#10; if (state.running) pause();&#10; else {&#10; try { if (window.AudioContext) new AudioContext().resume(); } catch (e) {}&#10; try {&#10; if (settings.notif &amp;&amp; 'Notification' in window &amp;&amp; Notification.permission === 'default') {&#10; Notification.requestPermission();&#10; }&#10; } catch (e) {}&#10; start();&#10; }&#10; });&#10; document.getElementById('pm-modal-ok').addEventListener('click', function () {&#10; document.getElementById('pm-modal').classList.remove('show');&#10; });&#10; document.getElementById('pm-modal').addEventListener('click', function (e) {&#10; if (e.target === this) this.classList.remove('show');&#10; });&#10; resetBtn.addEventListener('click', function () { setMode(state.mode); });&#10; document.querySelectorAll('.pm-mode-btn').forEach(function (b) {&#10; b.addEventListener('click', function () { setMode(b.dataset.mode); });&#10; });&#10; shareBtn.addEventListener('click', function () {&#10; if (stats.count === 0) { shareMsg.textContent = '今天还没有专注记录，先完成一个番茄钟再分享吧！'; return; }&#10; var url = 'https://leekairos.com/tools/pomodoro/?m=' + stats.minutes + '&amp;c=' + stats.count;&#10; function done() { shareMsg.textContent = '链接已复制，去分享你的专注成绩吧！'; }&#10; if (navigator.clipboard &amp;&amp; navigator.clipboard.writeText) {&#10; navigator.clipboard.writeText(url).then(done, function () { shareMsg.textContent = url; });&#10; } else { shareMsg.textContent = url; }&#10; });&#10;&#10; var setFocus = document.getElementById('pm-set-focus');&#10; var setShort = document.getElementById('pm-set-short');&#10; var setLong = document.getElementById('pm-set-long');&#10; var setCycle = document.getElementById('pm-set-cycle');&#10; var setAuto = document.getElementById('pm-set-auto');&#10; var setSound = document.getElementById('pm-set-sound');&#10; var setNotif = document.getElementById('pm-set-notif');&#10; setFocus.value = settings.focus; setShort.value = settings.short;&#10; setLong.value = settings.long; setCycle.value = settings.cycle;&#10; setAuto.checked = settings.auto; setSound.checked = settings.sound;&#10; setNotif.checked = settings.notif;&#10; function applySettings() {&#10; settings.focus = Math.max(1, +setFocus.value || 25);&#10; settings.short = Math.max(1, +setShort.value || 5);&#10; settings.long = Math.max(1, +setLong.value || 15);&#10; settings.cycle = Math.max(2, +setCycle.value || 4);&#10; settings.auto = setAuto.checked;&#10; settings.sound = setSound.checked;&#10; settings.notif = setNotif.checked;&#10; saveSettings();&#10; if (!state.running) setMode(state.mode);&#10; }&#10; [setFocus, setShort, setLong, setCycle].forEach(function (el) {&#10; el.addEventListener('change', applySettings);&#10; });&#10; setAuto.addEventListener('change', applySettings);&#10; setSound.addEventListener('change', applySettings);&#10; setNotif.addEventListener('change', applySettings);&#10;&#10; // shared result link: ?m=&lt;minutes&gt;&amp;c=&lt;count&gt;&#10; (function () {&#10; try {&#10; var p = new URLSearchParams(location.search);&#10; var m = +p.get('m'), c = +p.get('c');&#10; if (p.get('m') !== null &amp;&amp; p.get('c') !== null &amp;&amp; Number.isInteger(m) &amp;&amp; Number.isInteger(c)&#10; &amp;&amp; m &gt;= 0 &amp;&amp; m &lt;= 1440 &amp;&amp; c &gt;= 0 &amp;&amp; c &lt;= 100 &amp;&amp; (m &gt; 0 || c &gt; 0)) {&#10; document.getElementById('pm-shared-minutes').textContent = m;&#10; document.getElementById('pm-shared-count').textContent = c;&#10; document.getElementById('pm-shared-banner').style.display = 'block';&#10; }&#10; } catch (e) {}&#10; })();&#10;&#10; render();&#10;})();&#10;&lt;/script&gt;&#10;</description></item></channel></rss>