<?xml version="1.0" encoding="utf-8" standalone="yes"?><rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>Free Tools on Καιρός Lab</title><link>https://leekairos.com/en/tools/</link><description>Recent content in Free Tools on Καιρός Lab</description><generator>Hugo -- gohugo.io</generator><language>en</language><lastBuildDate>Fri, 20 Nov 2026 12:40:00 +0800</lastBuildDate><atom:link href="https://leekairos.com/en/tools/index.xml" rel="self" type="application/rss+xml"/><item><title>VARK Learning Style Quiz</title><link>https://leekairos.com/en/tools/vark/</link><pubDate>Fri, 20 Nov 2026 12:40:00 +0800</pubDate><guid>https://leekairos.com/en/tools/vark/</guid><description>&lt;style&gt;&#10; .vk-wrap { max-width: 600px; margin: 0 auto; text-align: center;&#10; --vk-card: #ffffff; --vk-text: #1c1c1e; --vk-muted: #6b7280; --vk-border: #e4e4e7;&#10; --vk-accent: #f59e0b; --vk-focus: #ef4444; --vk-ok: #22c55e; color: var(--vk-text); }&#10; html[data-scheme="dark"] .vk-wrap {&#10; --vk-card: #1e293b; --vk-text: #f1f5f9; --vk-muted: #94a3b8; --vk-border: #334155;&#10; --vk-accent: #f59e0b; }&#10; .vk-sub { color: var(--vk-muted); font-size: 14px; margin-bottom: 20px; }&#10; .vk-card { background: var(--vk-card); border: 1px solid var(--vk-border); border-radius: 20px;&#10; padding: 28px 24px; box-shadow: 0 4px 24px rgba(0,0,0,.06); text-align: left; }&#10; .vk-card h2 { font-size: 19px; line-height: 1.5; margin-bottom: 6px; }&#10; .vk-hint { color: var(--vk-muted); font-size: 13px; margin-bottom: 16px; }&#10; .vk-start-emoji { font-size: 56px; text-align: center; }&#10; .vk-start-text { color: var(--vk-muted); font-size: 15px; line-height: 1.8; margin: 14px 0 22px; }&#10; .vk-center { text-align: center; }&#10; .vk-progress { height: 8px; background: var(--vk-border); border-radius: 999px; overflow: hidden; margin-bottom: 8px; }&#10; .vk-progress-fill { height: 100%; background: var(--vk-accent); width: 0%; transition: width .3s; }&#10; .vk-progress-text { color: var(--vk-muted); font-size: 13px; margin-bottom: 16px; }&#10; .vk-opt { display: block; width: 100%; text-align: left; background: transparent;&#10; border: 1px solid var(--vk-border); border-radius: 12px; padding: 13px 15px;&#10; font-size: 15px; line-height: 1.5; color: var(--vk-text); cursor: pointer; margin-bottom: 10px; }&#10; .vk-opt:hover { border-color: var(--vk-accent); }&#10; .vk-opt.selected { border-color: var(--vk-accent); background: #fef3c7; }&#10; html[data-scheme="dark"] .vk-opt.selected { background: #451a03; }&#10; .vk-opt .vk-box { display: inline-block; width: 18px; height: 18px; border: 2px solid var(--vk-muted);&#10; border-radius: 5px; margin-right: 10px; vertical-align: -3px; text-align: center;&#10; line-height: 16px; font-size: 13px; color: #fff; }&#10; .vk-opt.selected .vk-box { background: var(--vk-accent); border-color: var(--vk-accent); }&#10; .vk-controls { display: flex; gap: 12px; justify-content: space-between; margin-top: 18px; }&#10; .vk-btn { border: none; border-radius: 12px; padding: 13px 28px; font-size: 16px; cursor: pointer; font-weight: 600; }&#10; .vk-btn-primary { background: var(--vk-focus); color: #fff; }&#10; .vk-btn-ghost { background: transparent; border: 1px solid var(--vk-border); color: var(--vk-text); }&#10; .vk-btn:disabled { opacity: .4; cursor: default; }&#10; #vk-warn { color: var(--vk-focus); font-size: 13px; margin-top: 12px; min-height: 18px; text-align: center; }&#10; .vk-result-emoji { font-size: 56px; text-align: center; }&#10; #vk-result-title { text-align: center; font-size: 22px; margin: 10px 0 8px; }&#10; #vk-result-desc { color: var(--vk-muted); font-size: 14px; line-height: 1.8; text-align: center; margin-bottom: 20px; }&#10; .vk-bar-row { margin-bottom: 12px; }&#10; .vk-bar-head { display: flex; justify-content: space-between; font-size: 14px; margin-bottom: 5px; }&#10; .vk-bar-head b { font-variant-numeric: tabular-nums; }&#10; .vk-bar-track { height: 10px; background: var(--vk-border); border-radius: 999px; overflow: hidden; }&#10; .vk-bar-fill { height: 100%; border-radius: 999px; }&#10; .vk-tips { margin-top: 20px; text-align: left; }&#10; .vk-tips h3 { font-size: 16px; margin-bottom: 8px; }&#10; .vk-tips ul { padding-left: 20px; }&#10; .vk-tips li { color: var(--vk-muted); font-size: 14px; line-height: 1.8; }&#10; .vk-share { text-align: center; margin-top: 20px; }&#10; .vk-share button { background: transparent; border: 1px dashed var(--vk-border); color: var(--vk-muted);&#10; border-radius: 999px; padding: 8px 18px; font-size: 13px; cursor: pointer; }&#10; #vk-share-msg { color: var(--vk-ok); font-size: 13px; margin-top: 8px; min-height: 18px; }&#10; .vk-restart { text-align: center; margin-top: 14px; }&#10; .vk-shared-note { background: #fef3c7; border: 1px solid var(--vk-accent); border-radius: 12px;&#10; padding: 10px 14px; font-size: 13px; color: var(--vk-muted); margin-bottom: 16px; text-align: center; }&#10; html[data-scheme="dark"] .vk-shared-note { background: #451a03; }&#10; .vk-info { text-align: left; margin-top: 8px; }&#10; .vk-info a { color: var(--vk-accent); }&#10;&lt;/style&gt;&#10;&lt;div class="vk-wrap"&gt;&#10;&lt;p class="vk-sub"&gt;16 questions · about 3 minutes · free · no sign-up&lt;/p&gt;&#10;&lt;div class="vk-card"&gt;&#10; &lt;div id="vk-start"&gt;&#10; &lt;div class="vk-start-emoji"&gt;🧠&lt;/div&gt;&#10; &lt;p class="vk-start-text"&gt;What is the fastest way for you to learn something? Looking at pictures, listening, reading and writing, or doing it yourself? The VARK model splits learning preferences into four styles: &lt;b&gt;Visual, Aural, Read / Write, and Kinesthetic&lt;/b&gt;. Answer 16 everyday scenarios and find the way that works best for you.&lt;/p&gt;&#10; &lt;div class="vk-center"&gt;&lt;button class="vk-btn vk-btn-primary" id="vk-start-btn"&gt;Start the Quiz&lt;/button&gt;&lt;/div&gt;&#10; &lt;p class="vk-hint vk-center" style="margin-top:14px;"&gt;You can pick more than one answer per question · No right or wrong · Your answers stay in your browser&lt;/p&gt;&#10; &lt;/div&gt;&#10; &lt;div id="vk-question" style="display:none"&gt;&#10; &lt;div class="vk-progress"&gt;&lt;div class="vk-progress-fill" id="vk-progress-fill"&gt;&lt;/div&gt;&lt;/div&gt;&#10; &lt;div class="vk-progress-text" id="vk-progress-text"&gt;Question 1 / 16&lt;/div&gt;&#10; &lt;h2 id="vk-q"&gt;&lt;/h2&gt;&#10; &lt;p class="vk-hint"&gt;You can select more than one: pick every option that fits you&lt;/p&gt;&#10; &lt;div id="vk-options"&gt;&lt;/div&gt;&#10; &lt;div class="vk-controls"&gt;&#10; &lt;button class="vk-btn vk-btn-ghost" id="vk-prev"&gt;Previous&lt;/button&gt;&#10; &lt;button class="vk-btn vk-btn-primary" id="vk-next"&gt;Next&lt;/button&gt;&#10; &lt;/div&gt;&#10; &lt;div id="vk-warn"&gt;&lt;/div&gt;&#10; &lt;/div&gt;&#10; &lt;div id="vk-result" style="display:none"&gt;&#10; &lt;div class="vk-shared-note" id="vk-shared-note" style="display:none"&gt;🔗 This is a quiz result shared by a friend&lt;/div&gt;&#10; &lt;div class="vk-result-emoji" id="vk-result-emoji"&gt;🎨&lt;/div&gt;&#10; &lt;h2 id="vk-result-title"&gt;&lt;/h2&gt;&#10; &lt;p id="vk-result-desc"&gt;&lt;/p&gt;&#10; &lt;div id="vk-bars"&gt;&lt;/div&gt;&#10; &lt;div class="vk-tips" id="vk-tips"&gt;&lt;/div&gt;&#10; &lt;div class="vk-share"&gt;&#10; &lt;button id="vk-share-btn"&gt;🔗 Copy result link&lt;/button&gt;&#10; &lt;div id="vk-share-msg"&gt;&lt;/div&gt;&#10; &lt;/div&gt;&#10; &lt;div class="vk-restart"&gt;&lt;button class="vk-btn vk-btn-ghost" id="vk-restart"&gt;Take the quiz again&lt;/button&gt;&lt;/div&gt;&#10; &lt;/div&gt;&#10;&lt;/div&gt;&#10;&lt;div class="vk-info"&gt;&#10;&lt;h2 id="what-is-vark"&gt;What is VARK?&#10;&lt;/h2&gt;&lt;p&gt;VARK is a learning styles model by Neil Fleming from New Zealand. It groups the ways people prefer to take in information into four styles: Visual (diagrams, charts), Aural (listening, discussion), Read / Write (reading text, writing notes), and Kinesthetic (doing, practicing). No style is better than another — most people are a mix of several.&lt;/p&gt;&#10;&lt;h2 id="how-to-use-your-result"&gt;How to use your result?&#10;&lt;/h2&gt;&lt;ul&gt;&#10;&lt;li&gt;Learn new things the way that fits you: Visual learners draw more, Aural learners talk it out, Read/Write learners take notes, Kinesthetic learners practice right away.&lt;/li&gt;&#10;&lt;li&gt;Combining styles works even better: look at a diagram first, explain it to someone, then do it yourself.&lt;/li&gt;&#10;&lt;li&gt;To go deeper into &amp;ldquo;you only learn it once you can explain it&amp;rdquo;, try the Feynman Technique: teach what you learned to someone else — if you can&amp;rsquo;t explain it, you haven&amp;rsquo;t learned it.&lt;/li&gt;&#10;&lt;/ul&gt;&#10;&lt;h2 id="note"&gt;Note&#10;&lt;/h2&gt;&lt;p&gt;This is a self-assessment tool with original scenario questions. The result is for reference only and is not a professional assessment.&lt;/p&gt;&#10;&lt;h2 id="related-reading"&gt;Related reading&#10;&lt;/h2&gt;&lt;p&gt;&lt;a class="link" href="https://leekairos.com/en/p/episode-01-7902-articles/" target="_blank" rel="noopener"&#10; &gt;I Saved 7,902 Articles. Why Can&amp;rsquo;t I Use a Single One?&lt;/a&gt; — Learning is not about saving more. It is about processing things in the way that fits you.&lt;/p&gt;&#10;&lt;p&gt;&lt;a class="link" href="https://leekairos.com/en/tools/" &gt;More free tools →&lt;/a&gt;&lt;/p&gt;&#10;&lt;/div&gt;&#10;&lt;/div&gt;&#10;&lt;script&gt;&#10;(function () {&#10; var MODES = ["V", "A", "R", "K"];&#10; var QUESTIONS = [&#10; { q: "You want to learn a new app (for example, a video editor). How do you start?", options: [&#10; { t: "Look at the official screenshots or a video walkthrough first", m: "V" },&#10; { t: "Have someone explain it to me, or listen to an audio guide", m: "A" },&#10; { t: "Read the written manual or help docs first", m: "R" },&#10; { t: "Just open the app and start clicking — fix mistakes as I go", m: "K" } ] },&#10; { q: "You need to get to a place you have never been. How do you remember the way?", options: [&#10; { t: "Have someone tell me the way out loud", m: "A" },&#10; { t: "Look at a map and remember the turns and landmarks", m: "V" },&#10; { t: "Walk the route once and let my body remember the turns", m: "K" },&#10; { t: "Write the directions down and follow them step by step", m: "R" } ] },&#10; { q: "You need to memorize a phone number or password. What do you do?", options: [&#10; { t: "Write it down and copy it several times", m: "R" },&#10; { t: "Type it on the keyboard again and again until my fingers remember it", m: "K" },&#10; { t: "Picture the string of numbers in my head", m: "V" },&#10; { t: "Say it out loud again and again until the sound sticks", m: "A" } ] },&#10; { q: "You want to learn a new recipe. Which way do you prefer?", options: [&#10; { t: "Just start cooking and adjust by tasting", m: "K" },&#10; { t: "Follow photo steps or a video, copying what I see", m: "V" },&#10; { t: "Listen to someone explain it, or cook while listening", m: "A" },&#10; { t: "Follow the written recipe step by step", m: "R" } ] },&#10; { q: "At work you need to understand a complex new concept (for example, a system architecture). What do you do?", options: [&#10; { t: "Talk it through with a colleague", m: "A" },&#10; { t: "Read the docs, papers, or the relevant chapters of a book", m: "R" },&#10; { t: "Build a small example, run it, and verify by doing", m: "K" },&#10; { t: "Draw a diagram showing how the parts relate", m: "V" } ] },&#10; { q: "You are preparing for an exam. What is your most effective way to review?", options: [&#10; { t: "Make mind maps and highlight key points in different colors", m: "V" },&#10; { t: "Re-read my notes, rewrite the key points, and write summaries", m: "R" },&#10; { t: "Do practice questions and mock exams", m: "K" },&#10; { t: "Explain the material to someone else, or record myself and listen back", m: "A" } ] },&#10; { q: "In a meeting, someone presents a new plan. How do you follow along?", options: [&#10; { t: "Take notes and write down the key points", m: "R" },&#10; { t: "Listen carefully and repeat it in my head as I go", m: "A" },&#10; { t: "Watch the diagrams and keywords on the whiteboard or slides", m: "V" },&#10; { t: "Sketch while listening, or fiddle with something in my hands to think", m: "K" } ] },&#10; { q: "You want to remember someone's name and face. What do you do?", options: [&#10; { t: "Shake hands and do something together — remember them through the interaction", m: "K" },&#10; { t: "Say their name several times and remember how it sounds", m: "A" },&#10; { t: "Write the name down, or save it in my contacts with a note", m: "R" },&#10; { t: "Remember their face, clothes, and how they look", m: "V" } ] },&#10; { q: "You are learning a new language. Which way do you like best?", options: [&#10; { t: "Flashcards with pictures, charts, and videos", m: "V" },&#10; { t: "Speak and use it in real situations — learn by using it", m: "K" },&#10; { t: "Listen a lot and repeat out loud — learn by ear and mouth", m: "A" },&#10; { t: "Read texts, write down words, and keep grammar notes", m: "R" } ] },&#10; { q: "You bought an unfamiliar appliance (for example, a coffee machine). How do you learn to use it?", options: [&#10; { t: "Ask the shop assistant or a friend to show me and explain it", m: "A" },&#10; { t: "Just turn it on and press the buttons one by one", m: "K" },&#10; { t: "Read the written steps in the manual carefully", m: "R" },&#10; { t: "Look at the diagrams in the manual or a demo video online", m: "V" } ] },&#10; { q: "You need to explain an idea to someone. What do you do?", options: [&#10; { t: "Write it out or send them a document", m: "R" },&#10; { t: "Draw a picture or find one that shows it", m: "V" },&#10; { t: "Demonstrate with a real object, or walk them through it hands-on", m: "K" },&#10; { t: "Just say it out loud, adjusting as I go", m: "A" } ] },&#10; { q: "You are reading a non-fiction book. How do you get the most out of it?", options: [&#10; { t: "Find a place to put the ideas into practice right after reading", m: "K" },&#10; { t: "Take written notes, underline, and write a short review", m: "R" },&#10; { t: "Draw diagrams and chart-style notes as I read", m: "V" },&#10; { t: "Listen to the audiobook, or read it out loud", m: "A" } ] },&#10; { q: "You are learning a dance move or a sports technique. What do you do?", options: [&#10; { t: "Listen to the coach explain the key points out loud", m: "A" },&#10; { t: "Watch the coach or a video and copy the movements", m: "V" },&#10; { t: "Read the written step-by-step breakdown first, then try it", m: "R" },&#10; { t: "Just follow along and adjust by feel", m: "K" } ] },&#10; { q: "You need to remember your schedule for the week. What do you do?", options: [&#10; { t: "Mark it on a calendar with color blocks so I can see it at a glance", m: "V" },&#10; { t: "Say the day's plan out loud to myself every morning", m: "A" },&#10; { t: "Tie each item to a concrete action (for example, “go for a run right after the meeting”)", m: "K" },&#10; { t: "Write a to-do list and check items off one by one", m: "R" } ] },&#10; { q: "You have a repair problem (for example, replacing a faucet). What do you do?", options: [&#10; { t: "Find a written repair guide and follow the steps", m: "R" },&#10; { t: "Take it apart and figure it out as I go", m: "K" },&#10; { t: "Call a friend who knows how, and follow their spoken instructions", m: "A" },&#10; { t: "Search for an exploded diagram or a video and follow the pictures", m: "V" } ] },&#10; { q: "Think about something you learned recently. What makes you remember it best?", options: [&#10; { t: "Remembering the thing I actually did with my own hands", m: "K" },&#10; { t: "Pictures and diagrams from that time coming back to mind", m: "V" },&#10; { t: "The notes and words I wrote down myself", m: "R" },&#10; { t: "The explanations and discussions I heard at the time", m: "A" } ] }&#10; ];&#10; var STYLES = {&#10; V: { name: "Visual", emoji: "🎨", color: "#3b82f6",&#10; desc: "You learn with your eyes: diagrams, colors, and images are what stick. What you see goes in more easily than what you hear.",&#10; tips: ["Organize knowledge with mind maps and flowcharts", "Highlight key points in different colors", "Watch videos and illustrated tutorials", "Draw abstract ideas out before trying to understand them"] },&#10; A: { name: "Aural", emoji: "👂", color: "#22c55e",&#10; desc: "You learn with your ears: listening, discussing, and repeating out loud are what stick. Saying it and hearing it is how you learn.",&#10; tips: ["Explain things to someone else (the Feynman Technique)", "Listen to podcasts and audiobooks", "Record yourself explaining and listen back", "Join discussions instead of only reading"] },&#10; R: { name: "Read/Write", emoji: "✍️", color: "#f59e0b",&#10; desc: "You learn with words: reading, writing, and organizing notes are what stick. Once you write it down, it is truly yours.",&#10; tips: ["Take written notes and summaries", "Organize knowledge with lists and outlines", "Write more: blog posts, reviews, reflections", "Read original books and official documentation"] },&#10; K: { name: "Kinesthetic", emoji: "🙌", color: "#ef4444",&#10; desc: "You learn by doing: practice, experience, and trial and error are what stick. Doing it once beats watching it ten times.",&#10; tips: ["Learn by doing — start a small project right away", "Practice with exercises, simulations, and hands-on work", "Move around and gesture while learning", "Apply what you learn to real situations"] }&#10; };&#10;&#10; var startScreen = document.getElementById("vk-start");&#10; var questionScreen = document.getElementById("vk-question");&#10; var resultScreen = document.getElementById("vk-result");&#10; var qText = document.getElementById("vk-q");&#10; var optionsEl = document.getElementById("vk-options");&#10; var progressFill = document.getElementById("vk-progress-fill");&#10; var progressText = document.getElementById("vk-progress-text");&#10; var prevBtn = document.getElementById("vk-prev");&#10; var nextBtn = document.getElementById("vk-next");&#10; var warnMsg = document.getElementById("vk-warn");&#10; var shareBtn = document.getElementById("vk-share-btn");&#10; var shareMsg = document.getElementById("vk-share-msg");&#10; var restartBtn = document.getElementById("vk-restart");&#10;&#10; var idx = 0;&#10; var answers = QUESTIONS.map(function () { return []; });&#10; var resultLabel = "";&#10; var shownCounts = null;&#10;&#10; function show(screen) {&#10; startScreen.style.display = "none";&#10; questionScreen.style.display = "none";&#10; resultScreen.style.display = "none";&#10; screen.style.display = "block";&#10; }&#10; function renderQuestion() {&#10; var q = QUESTIONS[idx];&#10; qText.textContent = q.q;&#10; progressFill.style.width = ((idx + 1) / QUESTIONS.length * 100) + "%";&#10; progressText.textContent = "Question " + (idx + 1) + " / " + QUESTIONS.length;&#10; prevBtn.disabled = idx === 0;&#10; nextBtn.textContent = idx === QUESTIONS.length - 1 ? "See My Result" : "Next";&#10; warnMsg.textContent = "";&#10; optionsEl.innerHTML = "";&#10; q.options.forEach(function (opt, i) {&#10; var b = document.createElement("button");&#10; b.className = "vk-opt" + (answers[idx].indexOf(i) !== -1 ? " selected" : "");&#10; b.innerHTML = '&lt;span class="vk-box"&gt;' + (answers[idx].indexOf(i) !== -1 ? "✓" : "") + "&lt;/span&gt;" + opt.t;&#10; b.addEventListener("click", function () {&#10; var pos = answers[idx].indexOf(i);&#10; if (pos === -1) answers[idx].push(i); else answers[idx].splice(pos, 1);&#10; renderQuestion();&#10; });&#10; optionsEl.appendChild(b);&#10; });&#10; }&#10; function score() {&#10; var counts = { V: 0, A: 0, R: 0, K: 0 };&#10; QUESTIONS.forEach(function (q, qi) {&#10; answers[qi].forEach(function (oi) { counts[q.options[oi].m] += 1; });&#10; });&#10; return counts;&#10; }&#10; function showResult(counts, shared) {&#10; if (!counts) counts = score();&#10; var max = Math.max(counts.V, counts.A, counts.R, counts.K);&#10; var preferred = MODES.filter(function (m) { return counts[m] &gt;= max - 2 &amp;&amp; counts[m] &gt; 0; });&#10; var title, desc, emoji;&#10; if (preferred.length === 1) {&#10; var s = STYLES[preferred[0]];&#10; emoji = s.emoji;&#10; title = "You are a " + s.name + " learner";&#10; desc = s.desc;&#10; } else {&#10; emoji = "🌈";&#10; title = "You are a multimodal learner";&#10; desc = "Your scores are close (" + preferred.map(function (m) { return STYLES[m].name; }).join(" + ") + "), so you don't rely on a single style — combining several ways works best for you.";&#10; }&#10; document.getElementById("vk-result-emoji").textContent = emoji;&#10; document.getElementById("vk-result-title").textContent = title;&#10; document.getElementById("vk-result-desc").textContent = desc;&#10; resultLabel = preferred.map(function (m) { return STYLES[m].name; }).join(" + ") + (preferred.length &gt; 1 ? " (multimodal)" : "");&#10; shownCounts = counts;&#10; if (shared) {&#10; document.getElementById("vk-shared-note").style.display = "block";&#10; restartBtn.textContent = "Take the quiz yourself";&#10; } else {&#10; document.getElementById("vk-shared-note").style.display = "none";&#10; restartBtn.textContent = "Take the quiz again";&#10; }&#10; var bars = document.getElementById("vk-bars");&#10; bars.innerHTML = "";&#10; MODES.forEach(function (m) {&#10; var s = STYLES[m];&#10; var row = document.createElement("div");&#10; row.className = "vk-bar-row";&#10; row.innerHTML = '&lt;div class="vk-bar-head"&gt;&lt;span&gt;' + s.emoji + " " + s.name + '&lt;/span&gt;&lt;b&gt;' + counts[m] + " / 16&lt;/b&gt;&lt;/div&gt;"&#10; + '&lt;div class="vk-bar-track"&gt;&lt;div class="vk-bar-fill" style="width:' + (counts[m] / 16 * 100) + "%;background:" + s.color + '"&gt;&lt;/div&gt;&lt;/div&gt;';&#10; bars.appendChild(row);&#10; });&#10; var tipsBox = document.getElementById("vk-tips");&#10; tipsBox.innerHTML = "&lt;h3&gt;Study methods that fit you&lt;/h3&gt;";&#10; preferred.forEach(function (m) {&#10; var s = STYLES[m];&#10; var h = document.createElement("p");&#10; h.style.cssText = "font-weight:600;margin:10px 0 4px;";&#10; h.textContent = s.emoji + " " + s.name;&#10; tipsBox.appendChild(h);&#10; var ul = document.createElement("ul");&#10; s.tips.forEach(function (t) {&#10; var li = document.createElement("li");&#10; li.textContent = t;&#10; ul.appendChild(li);&#10; });&#10; tipsBox.appendChild(ul);&#10; });&#10; show(resultScreen);&#10; }&#10;&#10; document.getElementById("vk-start-btn").addEventListener("click", function () {&#10; idx = 0;&#10; answers = QUESTIONS.map(function () { return []; });&#10; show(questionScreen);&#10; renderQuestion();&#10; });&#10; prevBtn.addEventListener("click", function () {&#10; if (idx &gt; 0) { idx -= 1; renderQuestion(); }&#10; });&#10; nextBtn.addEventListener("click", function () {&#10; if (answers[idx].length === 0) { warnMsg.textContent = "Please pick at least one option to continue."; return; }&#10; if (idx === QUESTIONS.length - 1) showResult();&#10; else { idx += 1; renderQuestion(); }&#10; });&#10; document.getElementById("vk-restart").addEventListener("click", function () {&#10; idx = 0;&#10; answers = QUESTIONS.map(function () { return []; });&#10; shareMsg.textContent = "";&#10; show(startScreen);&#10; });&#10; shareBtn.addEventListener("click", function () {&#10; var c = shownCounts || score();&#10; var url = "https://leekairos.com/en/tools/vark/?v=" + c.V + "&amp;a=" + c.A + "&amp;r=" + c.R + "&amp;k=" + c.K;&#10; function done() { shareMsg.textContent = "Link copied! Share your quiz result."; }&#10; if (navigator.clipboard &amp;&amp; navigator.clipboard.writeText) {&#10; navigator.clipboard.writeText(url).then(done, function () { shareMsg.textContent = url; });&#10; } else { shareMsg.textContent = url; }&#10; });&#10;&#10; // shared result link: ?v=..&amp;a=..&amp;r=..&amp;k=..&#10; (function () {&#10; try {&#10; var p = new URLSearchParams(location.search);&#10; var c = { V: +p.get("v"), A: +p.get("a"), R: +p.get("r"), K: +p.get("k") };&#10; var ok = MODES.every(function (m) {&#10; return p.get(m.toLowerCase()) !== null &amp;&amp; Number.isInteger(c[m]) &amp;&amp; c[m] &gt;= 0 &amp;&amp; c[m] &lt;= 16;&#10; });&#10; if (ok &amp;&amp; (c.V + c.A + c.R + c.K) &gt; 0) { showResult(c, true); }&#10; } catch (e) {}&#10; })();&#10;})();&#10;&lt;/script&gt;&#10;</description></item><item><title>Online Pomodoro Timer</title><link>https://leekairos.com/en/tools/pomodoro/</link><pubDate>Fri, 20 Nov 2026 11:00:00 +0800</pubDate><guid>https://leekairos.com/en/tools/pomodoro/</guid><description>&lt;style&gt;&#10; .pm-wrap { max-width: 560px; margin: 0 auto; text-align: center;&#10; --pm-card: #ffffff; --pm-text: #1c1c1e; --pm-muted: #6b7280; --pm-border: #e4e4e7;&#10; --pm-accent: #f59e0b; --pm-focus: #ef4444; --pm-short: #22c55e; --pm-long: #3b82f6;&#10; --pm-ring: #e5e7eb; --pm-input-bg: #f4f4f5; color: var(--pm-text); }&#10; html[data-scheme="dark"] .pm-wrap {&#10; --pm-card: #1e293b; --pm-text: #f1f5f9; --pm-muted: #94a3b8; --pm-border: #334155;&#10; --pm-accent: #f59e0b; --pm-ring: #334155; --pm-input-bg: #0f172a; }&#10; .pm-sub { color: var(--pm-muted); font-size: 14px; margin-bottom: 20px; }&#10; .pm-card { background: var(--pm-card); border: 1px solid var(--pm-border);&#10; border-radius: 20px; padding: 28px 24px 24px; box-shadow: 0 4px 24px rgba(0,0,0,.06); }&#10; .pm-modes { display: flex; gap: 8px; justify-content: center; margin-bottom: 20px; flex-wrap: wrap; }&#10; .pm-mode-btn { border: 1px solid var(--pm-border); background: transparent; color: var(--pm-muted);&#10; padding: 8px 16px; border-radius: 999px; font-size: 14px; cursor: pointer; }&#10; .pm-mode-btn.active[data-mode="focus"] { background: var(--pm-focus); border-color: var(--pm-focus); color: #fff; }&#10; .pm-mode-btn.active[data-mode="short"] { background: var(--pm-short); border-color: var(--pm-short); color: #fff; }&#10; .pm-mode-btn.active[data-mode="long"] { background: var(--pm-long); border-color: var(--pm-long); color: #fff; }&#10; .pm-ring-wrap { position: relative; width: 260px; height: 260px; margin: 0 auto 8px; }&#10; .pm-ring-wrap svg { transform: rotate(-90deg); }&#10; .pm-ring-bg { fill: none; stroke: var(--pm-ring); stroke-width: 10; }&#10; .pm-ring-fg { fill: none; stroke: var(--pm-focus); stroke-width: 10; stroke-linecap: round;&#10; transition: stroke-dashoffset .3s linear, stroke .3s; }&#10; .pm-time-box { position: absolute; inset: 0; display: flex; flex-direction: column;&#10; align-items: center; justify-content: center; }&#10; #pm-time { font-size: 56px; font-weight: 700; font-variant-numeric: tabular-nums; letter-spacing: 2px; }&#10; #pm-mode-label { color: var(--pm-muted); font-size: 15px; margin-top: 4px; }&#10; .pm-dots { display: flex; gap: 8px; justify-content: center; margin: 10px 0 18px; }&#10; .pm-dot { width: 12px; height: 12px; border-radius: 50%; border: 2px solid var(--pm-muted); }&#10; .pm-dot.done { background: var(--pm-focus); border-color: var(--pm-focus); }&#10; .pm-controls { display: flex; gap: 12px; justify-content: center; }&#10; .pm-btn { border: none; border-radius: 12px; padding: 13px 34px; font-size: 17px;&#10; cursor: pointer; font-weight: 600; }&#10; .pm-btn-primary { background: var(--pm-focus); color: #fff; }&#10; .pm-btn-primary.break-short { background: var(--pm-short); }&#10; .pm-btn-primary.break-long { background: var(--pm-long); }&#10; .pm-btn-ghost { background: transparent; border: 1px solid var(--pm-border); color: var(--pm-text); }&#10; .pm-stats { display: flex; justify-content: center; gap: 28px; margin-top: 22px;&#10; padding-top: 18px; border-top: 1px solid var(--pm-border); text-align: center; }&#10; .pm-stats b { font-size: 22px; display: block; }&#10; .pm-stats span { color: var(--pm-muted); font-size: 13px; }&#10; .pm-share { text-align: center; margin-top: 16px; }&#10; .pm-share button { background: transparent; border: 1px dashed var(--pm-border); color: var(--pm-muted);&#10; border-radius: 999px; padding: 8px 18px; font-size: 13px; cursor: pointer; }&#10; #pm-share-msg { color: var(--pm-short); font-size: 13px; margin-top: 8px; min-height: 18px; }&#10; .pm-details { margin-top: 22px; border-top: 1px solid var(--pm-border); padding-top: 16px; text-align: left; }&#10; .pm-summary { cursor: pointer; font-weight: 600; font-size: 15px; }&#10; .pm-settings { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 14px; }&#10; .pm-settings label { font-size: 13px; color: var(--pm-muted); display: block; margin-bottom: 4px; }&#10; .pm-settings input[type="number"] { width: 100%; padding: 9px 10px; border: 1px solid var(--pm-border);&#10; border-radius: 9px; font-size: 15px; background: var(--pm-input-bg); color: var(--pm-text); }&#10; .pm-check { display: flex; align-items: center; gap: 8px; font-size: 14px; margin-top: 14px; }&#10; .pm-info { text-align: left; margin-top: 8px; }&#10; .pm-info a { color: var(--pm-accent); }&#10; .pm-more-tools { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }&#10; .pm-tool-chip { border: 1px solid var(--pm-border); border-radius: 999px; padding: 7px 14px;&#10; font-size: 13px; color: var(--pm-muted); }&#10; .pm-modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,.5); display: none;&#10; align-items: center; justify-content: center; z-index: 50; padding: 20px; }&#10; .pm-modal-overlay.show { display: flex; }&#10; .pm-modal { background: var(--pm-card); border: 1px solid var(--pm-border); border-radius: 20px;&#10; padding: 28px 24px; text-align: center; max-width: 340px; width: 100%;&#10; box-shadow: 0 12px 40px rgba(0,0,0,.25); }&#10; .pm-modal .pm-big { font-size: 44px; }&#10; .pm-modal h3 { font-size: 22px; margin: 10px 0 6px; }&#10; .pm-modal p { color: var(--pm-muted); font-size: 14px; line-height: 1.7; }&#10; .pm-modal .pm-btn { margin-top: 18px; }&#10; .pm-shared-banner { background: #fef3c7; border: 1px solid var(--pm-accent); border-radius: 12px;&#10; padding: 12px 16px; font-size: 14px; color: var(--pm-muted); margin-bottom: 16px; text-align: center; line-height: 1.6; }&#10; .pm-shared-banner b { color: var(--pm-text); font-size: 16px; }&#10; html[data-scheme="dark"] .pm-shared-banner { background: #451a03; }&#10;&lt;/style&gt;&#10;&lt;div class="pm-wrap"&gt;&#10;&lt;p class="pm-sub"&gt;Free · No sign-up · Works right away&lt;/p&gt;&#10;&lt;div class="pm-shared-banner" id="pm-shared-banner" style="display:none"&gt;🍅 Shared by a friend: &lt;b id="pm-shared-minutes"&gt;0&lt;/b&gt; min focused today, &lt;b id="pm-shared-count"&gt;0&lt;/b&gt; Pomodoros done&lt;/div&gt;&#10;&lt;div class="pm-card"&gt;&#10; &lt;div class="pm-modes"&gt;&#10; &lt;button class="pm-mode-btn active" data-mode="focus"&gt;Focus&lt;/button&gt;&#10; &lt;button class="pm-mode-btn" data-mode="short"&gt;Short Break&lt;/button&gt;&#10; &lt;button class="pm-mode-btn" data-mode="long"&gt;Long Break&lt;/button&gt;&#10; &lt;/div&gt;&#10; &lt;div class="pm-ring-wrap"&gt;&#10; &lt;svg width="260" height="260" viewBox="0 0 260 260"&gt;&#10; &lt;circle class="pm-ring-bg" cx="130" cy="130" r="118"&gt;&lt;/circle&gt;&#10; &lt;circle class="pm-ring-fg" id="pm-ring" cx="130" cy="130" r="118"&gt;&lt;/circle&gt;&#10; &lt;/svg&gt;&#10; &lt;div class="pm-time-box"&gt;&#10; &lt;div id="pm-time"&gt;25:00&lt;/div&gt;&#10; &lt;div id="pm-mode-label"&gt;Focusing · Pomodoro 1&lt;/div&gt;&#10; &lt;/div&gt;&#10; &lt;/div&gt;&#10; &lt;div class="pm-dots" id="pm-dots"&gt;&#10; &lt;span class="pm-dot"&gt;&lt;/span&gt;&lt;span class="pm-dot"&gt;&lt;/span&gt;&lt;span class="pm-dot"&gt;&lt;/span&gt;&lt;span class="pm-dot"&gt;&lt;/span&gt;&#10; &lt;/div&gt;&#10; &lt;div class="pm-controls"&gt;&#10; &lt;button class="pm-btn pm-btn-primary" id="pm-start"&gt;Start&lt;/button&gt;&#10; &lt;button class="pm-btn pm-btn-ghost" id="pm-reset"&gt;Reset&lt;/button&gt;&#10; &lt;/div&gt;&#10; &lt;div class="pm-stats"&gt;&#10; &lt;div&gt;&lt;b id="pm-today-count"&gt;0&lt;/b&gt;&lt;span&gt;Pomodoros today&lt;/span&gt;&lt;/div&gt;&#10; &lt;div&gt;&lt;b id="pm-today-minutes"&gt;0 min&lt;/b&gt;&lt;span&gt;Focus today&lt;/span&gt;&lt;/div&gt;&#10; &lt;div&gt;&lt;b id="pm-cycle-count"&gt;0 / 4&lt;/b&gt;&lt;span&gt;Cycle&lt;/span&gt;&lt;/div&gt;&#10; &lt;/div&gt;&#10; &lt;div class="pm-share"&gt;&#10; &lt;button id="pm-share-btn"&gt;🔗 Copy my focus link&lt;/button&gt;&#10; &lt;div id="pm-share-msg"&gt;&lt;/div&gt;&#10; &lt;/div&gt;&#10; &lt;details class="pm-details"&gt;&#10; &lt;summary class="pm-summary"&gt;⚙️ Settings&lt;/summary&gt;&#10; &lt;div class="pm-settings"&gt;&#10; &lt;div&gt;&lt;label&gt;Focus length (min)&lt;/label&gt;&lt;input type="number" id="pm-set-focus" value="25" min="1" max="120"&gt;&lt;/div&gt;&#10; &lt;div&gt;&lt;label&gt;Short break (min)&lt;/label&gt;&lt;input type="number" id="pm-set-short" value="5" min="1" max="30"&gt;&lt;/div&gt;&#10; &lt;div&gt;&lt;label&gt;Long break (min)&lt;/label&gt;&lt;input type="number" id="pm-set-long" value="15" min="1" max="60"&gt;&lt;/div&gt;&#10; &lt;div&gt;&lt;label&gt;Pomodoros before a long break&lt;/label&gt;&lt;input type="number" id="pm-set-cycle" value="4" min="2" max="8"&gt;&lt;/div&gt;&#10; &lt;/div&gt;&#10; &lt;label class="pm-check"&gt;&lt;input type="checkbox" id="pm-set-auto" checked&gt; Auto-switch to the next stage when one ends&lt;/label&gt;&#10; &lt;label class="pm-check"&gt;&lt;input type="checkbox" id="pm-set-sound" checked&gt; Play a sound when time is up&lt;/label&gt;&#10; &lt;label class="pm-check"&gt;&lt;input type="checkbox" id="pm-set-notif" checked&gt; Show a browser notification when time is up (visible even on another tab)&lt;/label&gt;&#10; &lt;/details&gt;&#10;&lt;/div&gt;&#10;&lt;div class="pm-info"&gt;&#10;&lt;h2 id="what-is-the-pomodoro-technique"&gt;What is the Pomodoro Technique?&#10;&lt;/h2&gt;&lt;p&gt;The Pomodoro Technique is simple: focus for 25 minutes, then take a 5-minute break — that is one Pomodoro. After every 4 Pomodoros, take a longer 15-minute break. Short, fixed rhythms make it easier to concentrate and harder to burn out.&lt;/p&gt;&#10;&lt;h2 id="how-to-use-it"&gt;How to use it?&#10;&lt;/h2&gt;&lt;ol&gt;&#10;&lt;li&gt;Press Start and do just one thing for 25 minutes. Put your phone aside.&lt;/li&gt;&#10;&lt;li&gt;When time is up, a popup appears and a sound plays — even if you switched to another tab, the browser notification pops up. Stand up, walk around, drink some water, and rest for 5 minutes.&lt;/li&gt;&#10;&lt;li&gt;After 4 Pomodoros, take yourself a 15-minute long break.&lt;/li&gt;&#10;&lt;li&gt;Your daily Pomodoro count and focus minutes are saved automatically — closing the page won&amp;rsquo;t lose them.&lt;/li&gt;&#10;&lt;/ol&gt;&#10;&lt;h2 id="more-tools-coming-soon"&gt;More tools (coming soon)&#10;&lt;/h2&gt;&lt;div class="pm-more-tools"&gt;&#10; &lt;span class="pm-tool-chip"&gt;📇 English flashcards&lt;/span&gt;&#10; &lt;span class="pm-tool-chip"&gt;⌨️ Typing speed test&lt;/span&gt;&#10; &lt;span class="pm-tool-chip"&gt;📖 Reading speed test&lt;/span&gt;&#10; &lt;span class="pm-tool-chip"&gt;🎲 Random speaking topics&lt;/span&gt;&#10;&lt;/div&gt;&#10;&lt;h2 id="related-reading"&gt;Related reading&#10;&lt;/h2&gt;&lt;p&gt;&lt;a class="link" href="https://leekairos.com/en/p/episode-01-7902-articles/" target="_blank" rel="noopener"&#10; &gt;I Saved 7,902 Articles. Why Can&amp;rsquo;t I Use a Single One?&lt;/a&gt; — Saving more is no substitute for 25 minutes of focused processing a day.&lt;/p&gt;&#10;&lt;p&gt;&lt;a class="link" href="https://leekairos.com/en/tools/" &gt;More free tools →&lt;/a&gt;&lt;/p&gt;&#10;&lt;/div&gt;&#10;&lt;div class="pm-modal-overlay" id="pm-modal"&gt;&#10; &lt;div class="pm-modal"&gt;&#10; &lt;div class="pm-big" id="pm-modal-emoji"&gt;⏰&lt;/div&gt;&#10; &lt;h3 id="pm-modal-title"&gt;Time's up!&lt;/h3&gt;&#10; &lt;p id="pm-modal-text"&gt;&lt;/p&gt;&#10; &lt;button class="pm-btn pm-btn-primary" id="pm-modal-ok"&gt;Got it&lt;/button&gt;&#10; &lt;/div&gt;&#10;&lt;/div&gt;&#10;&lt;/div&gt;&#10;&lt;script&gt;&#10;(function () {&#10; var CIRC = 2 * Math.PI * 118;&#10; var ring = document.getElementById('pm-ring');&#10; var timeEl = document.getElementById('pm-time');&#10; var modeLabel = document.getElementById('pm-mode-label');&#10; var startBtn = document.getElementById('pm-start');&#10; var resetBtn = document.getElementById('pm-reset');&#10; var dotsEl = document.getElementById('pm-dots');&#10; var todayCountEl = document.getElementById('pm-today-count');&#10; var todayMinutesEl = document.getElementById('pm-today-minutes');&#10; var cycleCountEl = document.getElementById('pm-cycle-count');&#10; var shareBtn = document.getElementById('pm-share-btn');&#10; var shareMsg = document.getElementById('pm-share-msg');&#10;&#10; var COLORS = { focus: '#ef4444', short: '#22c55e', long: '#3b82f6' };&#10; var LABELS = { focus: 'Focus', short: 'Short break', long: 'Long break' };&#10;&#10; var settings = loadSettings();&#10; var state = { mode: 'focus', running: false, remaining: settings.focus * 60, endAt: 0, timer: null, completedInCycle: 0 };&#10; var stats = loadStats();&#10;&#10; ring.style.strokeDasharray = CIRC;&#10; ring.style.strokeDashoffset = 0;&#10;&#10; function loadSettings() {&#10; try {&#10; var s = JSON.parse(localStorage.getItem('pomodoro-settings') || '{}');&#10; return {&#10; focus: s.focus || 25, short: s.short || 5, long: s.long || 15,&#10; cycle: s.cycle || 4, auto: s.auto !== false, sound: s.sound !== false,&#10; notif: s.notif !== false&#10; };&#10; } catch (e) {&#10; return { focus: 25, short: 5, long: 15, cycle: 4, auto: true, sound: true, notif: true };&#10; }&#10; }&#10; function saveSettings() {&#10; try { localStorage.setItem('pomodoro-settings', JSON.stringify(settings)); } catch (e) {}&#10; }&#10; function todayKey() { return new Date().toISOString().slice(0, 10); }&#10; function loadStats() {&#10; try {&#10; var s = JSON.parse(localStorage.getItem('pomodoro-stats') || '{}');&#10; if (s.date !== todayKey()) return { date: todayKey(), count: 0, minutes: 0 };&#10; return s;&#10; } catch (e) { return { date: todayKey(), count: 0, minutes: 0 }; }&#10; }&#10; function saveStats() {&#10; try { localStorage.setItem('pomodoro-stats', JSON.stringify(stats)); } catch (e) {}&#10; }&#10;&#10; function fmt(sec) {&#10; sec = Math.max(0, Math.ceil(sec));&#10; var m = Math.floor(sec / 60), s = sec % 60;&#10; return (m &lt; 10 ? '0' : '') + m + ':' + (s &lt; 10 ? '0' : '') + s;&#10; }&#10; function totalFor(mode) {&#10; return (mode === 'focus' ? settings.focus : mode === 'short' ? settings.short : settings.long) * 60;&#10; }&#10; function render() {&#10; timeEl.textContent = fmt(state.remaining);&#10; ring.style.stroke = COLORS[state.mode];&#10; ring.style.strokeDashoffset = CIRC * (1 - state.remaining / totalFor(state.mode));&#10; startBtn.textContent = state.running ? 'Pause' : (state.remaining &lt; totalFor(state.mode) ? 'Resume' : 'Start');&#10; startBtn.classList.toggle('break-short', state.mode === 'short');&#10; startBtn.classList.toggle('break-long', state.mode === 'long');&#10; modeLabel.textContent = state.mode === 'focus'&#10; ? 'Focusing · Pomodoro ' + (state.completedInCycle + 1)&#10; : LABELS[state.mode];&#10; document.title = fmt(state.remaining) + ' · ' + LABELS[state.mode] + ' | Online Pomodoro Timer';&#10; var dots = dotsEl.children;&#10; for (var i = 0; i &lt; dots.length; i++) {&#10; dots[i].classList.toggle('done', i &lt; state.completedInCycle);&#10; }&#10; todayCountEl.textContent = stats.count;&#10; todayMinutesEl.textContent = stats.minutes + ' min';&#10; cycleCountEl.textContent = state.completedInCycle + ' / ' + settings.cycle;&#10; }&#10; function setMode(mode, resetRemaining) {&#10; state.mode = mode;&#10; state.running = false;&#10; clearInterval(state.timer);&#10; if (resetRemaining !== false) state.remaining = totalFor(mode);&#10; document.querySelectorAll('.pm-mode-btn').forEach(function (b) {&#10; b.classList.toggle('active', b.dataset.mode === mode);&#10; });&#10; render();&#10; }&#10; function beep() {&#10; if (!settings.sound) return;&#10; try {&#10; var ctx = new (window.AudioContext || window.webkitAudioContext)();&#10; [0, 1, 2, 3, 4, 5].forEach(function (i) {&#10; var o = ctx.createOscillator(), g = ctx.createGain();&#10; o.connect(g); g.connect(ctx.destination);&#10; o.frequency.value = 880;&#10; g.gain.setValueAtTime(0.0001, ctx.currentTime + i * 0.35);&#10; g.gain.exponentialRampToValueAtTime(0.25, ctx.currentTime + i * 0.35 + 0.02);&#10; g.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + i * 0.35 + 0.3);&#10; o.start(ctx.currentTime + i * 0.35);&#10; o.stop(ctx.currentTime + i * 0.35 + 0.32);&#10; });&#10; } catch (e) {}&#10; }&#10; function notify(title, body) {&#10; if (!settings.notif) return;&#10; try {&#10; if ('Notification' in window &amp;&amp; Notification.permission === 'granted') {&#10; new Notification(title, { body: body });&#10; }&#10; } catch (e) {}&#10; }&#10; function showModal(emoji, title, text) {&#10; document.getElementById('pm-modal-emoji').textContent = emoji;&#10; document.getElementById('pm-modal-title').textContent = title;&#10; document.getElementById('pm-modal-text').textContent = text;&#10; document.getElementById('pm-modal').classList.add('show');&#10; }&#10; function onFinish() {&#10; state.running = false;&#10; clearInterval(state.timer);&#10; beep();&#10; var nextMode, emoji, title, text;&#10; if (state.mode === 'focus') {&#10; stats.count += 1;&#10; stats.minutes += settings.focus;&#10; saveStats();&#10; state.completedInCycle += 1;&#10; nextMode = state.completedInCycle &gt;= settings.cycle ? 'long' : 'short';&#10; if (nextMode === 'long') state.completedInCycle = 0;&#10; emoji = '🍅';&#10; title = 'Focus done!';&#10; text = 'You completed ' + settings.focus + ' minutes of focus. ' + (settings.auto ? 'Your ' : 'Next: ')&#10; + (nextMode === 'long' ? 'long break, ' + settings.long + ' min' : 'short break, ' + settings.short + ' min')&#10; + (settings.auto ? ' has started.' : '.');&#10; notify('🍅 Focus done!', 'You focused for ' + settings.focus + ' minutes. Take a break.');&#10; } else {&#10; nextMode = 'focus';&#10; emoji = '⏰';&#10; title = 'Break over!';&#10; text = 'Break over. ' + (settings.auto ? 'Your next Pomodoro has started.' : 'Press Start when you are ready for the next Pomodoro.');&#10; notify('⏰ Break over!', 'Time for the next Pomodoro. Stay focused.');&#10; }&#10; showModal(emoji, title, text);&#10; setMode(nextMode);&#10; if (settings.auto) start();&#10; render();&#10; }&#10; function tick() {&#10; state.remaining = Math.max(0, (state.endAt - Date.now()) / 1000);&#10; if (state.remaining &lt;= 0) { onFinish(); return; }&#10; render();&#10; }&#10; function start() {&#10; state.running = true;&#10; state.endAt = Date.now() + state.remaining * 1000;&#10; clearInterval(state.timer);&#10; state.timer = setInterval(tick, 250);&#10; render();&#10; }&#10; function pause() {&#10; state.running = false;&#10; clearInterval(state.timer);&#10; render();&#10; }&#10; startBtn.addEventListener('click', function () {&#10; if (state.running) pause();&#10; else {&#10; try { if (window.AudioContext) new AudioContext().resume(); } catch (e) {}&#10; try {&#10; if (settings.notif &amp;&amp; 'Notification' in window &amp;&amp; Notification.permission === 'default') {&#10; Notification.requestPermission();&#10; }&#10; } catch (e) {}&#10; start();&#10; }&#10; });&#10; document.getElementById('pm-modal-ok').addEventListener('click', function () {&#10; document.getElementById('pm-modal').classList.remove('show');&#10; });&#10; document.getElementById('pm-modal').addEventListener('click', function (e) {&#10; if (e.target === this) this.classList.remove('show');&#10; });&#10; resetBtn.addEventListener('click', function () { setMode(state.mode); });&#10; document.querySelectorAll('.pm-mode-btn').forEach(function (b) {&#10; b.addEventListener('click', function () { setMode(b.dataset.mode); });&#10; });&#10; shareBtn.addEventListener('click', function () {&#10; if (stats.count === 0) { shareMsg.textContent = 'No focus sessions yet today — complete a Pomodoro first, then share!'; return; }&#10; var url = 'https://leekairos.com/en/tools/pomodoro/?m=' + stats.minutes + '&amp;c=' + stats.count;&#10; function done() { shareMsg.textContent = 'Link copied! Share your focus result.'; }&#10; if (navigator.clipboard &amp;&amp; navigator.clipboard.writeText) {&#10; navigator.clipboard.writeText(url).then(done, function () { shareMsg.textContent = url; });&#10; } else { shareMsg.textContent = url; }&#10; });&#10;&#10; var setFocus = document.getElementById('pm-set-focus');&#10; var setShort = document.getElementById('pm-set-short');&#10; var setLong = document.getElementById('pm-set-long');&#10; var setCycle = document.getElementById('pm-set-cycle');&#10; var setAuto = document.getElementById('pm-set-auto');&#10; var setSound = document.getElementById('pm-set-sound');&#10; var setNotif = document.getElementById('pm-set-notif');&#10; setFocus.value = settings.focus; setShort.value = settings.short;&#10; setLong.value = settings.long; setCycle.value = settings.cycle;&#10; setAuto.checked = settings.auto; setSound.checked = settings.sound;&#10; setNotif.checked = settings.notif;&#10; function applySettings() {&#10; settings.focus = Math.max(1, +setFocus.value || 25);&#10; settings.short = Math.max(1, +setShort.value || 5);&#10; settings.long = Math.max(1, +setLong.value || 15);&#10; settings.cycle = Math.max(2, +setCycle.value || 4);&#10; settings.auto = setAuto.checked;&#10; settings.sound = setSound.checked;&#10; settings.notif = setNotif.checked;&#10; saveSettings();&#10; if (!state.running) setMode(state.mode);&#10; }&#10; [setFocus, setShort, setLong, setCycle].forEach(function (el) {&#10; el.addEventListener('change', applySettings);&#10; });&#10; setAuto.addEventListener('change', applySettings);&#10; setSound.addEventListener('change', applySettings);&#10; setNotif.addEventListener('change', applySettings);&#10;&#10; // shared result link: ?m=&lt;minutes&gt;&amp;c=&lt;count&gt;&#10; (function () {&#10; try {&#10; var p = new URLSearchParams(location.search);&#10; var m = +p.get('m'), c = +p.get('c');&#10; if (p.get('m') !== null &amp;&amp; p.get('c') !== null &amp;&amp; Number.isInteger(m) &amp;&amp; Number.isInteger(c)&#10; &amp;&amp; m &gt;= 0 &amp;&amp; m &lt;= 1440 &amp;&amp; c &gt;= 0 &amp;&amp; c &lt;= 100 &amp;&amp; (m &gt; 0 || c &gt; 0)) {&#10; document.getElementById('pm-shared-minutes').textContent = m;&#10; document.getElementById('pm-shared-count').textContent = c;&#10; document.getElementById('pm-shared-banner').style.display = 'block';&#10; }&#10; } catch (e) {}&#10; })();&#10;&#10; render();&#10;})();&#10;&lt;/script&gt;&#10;</description></item></channel></rss>